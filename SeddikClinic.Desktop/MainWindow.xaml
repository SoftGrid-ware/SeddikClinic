<Window x:Class="SeddikClinic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منظومة عيادة د. صديق الموحدة - إدارة المواعيد والعمليات الطبية والمالية" 
        Height="840" Width="1340" 
        WindowStartupLocation="CenterScreen" 
        FlowDirection="RightToLeft"
        Background="#F8FAFC">

    <Grid>
        <!-- Layout with Sidebar and Dynamic View Container -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280"/> <!-- Luxury Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Dynamic View Container -->
        </Grid.ColumnDefinitions>

        <!-- Luxury White Sidebar (Visible after Login) -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo / Clinic Header -->
                    <RowDefinition Height="Auto"/> <!-- Current User Profile Badge Card -->
                    <RowDefinition Height="*"/>    <!-- Navigation Buttons -->
                    <RowDefinition Height="Auto"/> <!-- Cloud Status Footer & Logout -->
                </Grid.RowDefinitions>

                <!-- Clinic Logo Header -->
                <StackPanel Grid.Row="0" Margin="22,24,22,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" Background="#E0F2FE" CornerRadius="12" Margin="0,0,12,0">
                            <TextBlock Text="+" FontSize="24" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="عيادة د. صديق" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="المنظومة الموحدة الشاملة" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,16,0,0" Background="#F1F5F9"/>
                </StackPanel>

                <!-- Current User Profile Badge Card -->
                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="16,0,16,18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="CurrentUserFullNameText" Text="د. صديق" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="CurrentUserRoleBadgeText" Text="مدير المنظومة" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="خروج" Click="LogoutBtn_Click" Style="{StaticResource OutlineButtonStyle}" Height="30" Padding="8,2" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Navigation Menu (Dynamic Visibility by Permissions) -->
                <StackPanel Grid.Row="2" Margin="14,0">
                    <!-- Nav Item 1: Appointments & Booking -->
                    <Button x:Name="NavAppointmentsBtn" Click="NavAppointments_Click" Height="44" Background="#E0F2FE" Foreground="#0284C7" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="المواعيد والحجوزات" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 2: Patient Directory -->
                    <Button x:Name="NavPatientsBtn" Click="NavPatients_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="سجل المرضى" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 3: Financial Dashboard (Protected by Permission) -->
                    <Button x:Name="NavDashboardBtn" Click="NavDashboard_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="الأرباح والمصروفات" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 4: Expenses -->
                    <Button x:Name="NavExpensesBtn" Click="NavExpenses_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="إدارة المصروفات" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 5: Invoices & Billing -->
                    <Button x:Name="NavInvoicesBtn" Click="NavInvoices_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="الفواتير والتحصيل" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 6: User & Permissions Management (Manager Only) -->
                    <Button x:Name="NavUsersBtn" Click="NavUsers_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="المستخدمين والصلاحيات" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 7: Clinic Services & Pricing (Manager Only) -->
                    <Button x:Name="NavServicesBtn" Click="NavServices_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="الخدمات والأسعار" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 8: Facebook Marketing & AI Studio -->
                    <Button x:Name="NavMarketingBtn" Click="NavMarketing_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="📢 تسويق وفيسبوك" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nav Item 9: About & Developer Credits -->
                    <Button x:Name="NavAboutBtn" Click="NavAbout_Click" Height="44" Background="Transparent" Foreground="#64748B" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" HorizontalContentAlignment="Right" Padding="14,0">
                        <TextBlock Text="حول المنظومة والدعم" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Bottom Live Status, Server Link & Developer Credits Footer Card -->
                <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="12" Padding="12" Margin="14,0,14,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <!-- Status Header with Config Button -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock x:Name="CloudStatusText" Text="أونلاين (متصل)" FontSize="11" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="ConfigureServerBtn" Grid.Column="1" Content="⚙️ السيرفر" Click="OpenServerSettings_Click" Style="{StaticResource OutlineButtonStyle}" Height="24" Padding="6,1" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" ToolTip="عرض وتعديل رابط السيرفر وحالة الاتصال (للأدمن)"/>
                        </Grid>

                        <!-- Connected Server URL Badge -->
                        <Border Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="ConnectedServerUrlText" Text="http://localhost:5000" FontSize="10.5" Foreground="#0284C7" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                        </Border>

                        <!-- Subtitle & Sync Action -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CloudSubtitleText" Text="العيادة متصلة ومتزامنة لحظياً" FontSize="9.5" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="مزامنة 🔄" Click="ManualSync_Click" Style="{StaticResource OutlineButtonStyle}" Height="22" Padding="5,1" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#E2E8F0" Margin="0,3"/>
                        <TextBlock Text="برمجة: د. عبدالرحمن شعبان" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="01009563353" FontSize="9.5" Foreground="#0284C7" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Dynamic View Container -->
        <ContentControl x:Name="MainContentContainer" Grid.Column="1"/>

        <!-- Modal: إعدادات السيرفر وحالة الاتصال المباشرة (Server Connection & Endpoint Settings Modal) -->
        <Grid x:Name="ServerSettingsModal" Grid.Column="0" Grid.ColumnSpan="2" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="20" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="إعدادات وخادم المنظومة (Server Manager)" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="فحص حالة الاتصال بالسيرفر وتعديل عنوان الـ API للعيادة" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="CloseServerSettingsModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- 1. Live Connection Status Card -->
                    <Border x:Name="ModalServerStatusCard" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse x:Name="ModalServerStatusDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ModalServerStatusTitle" Text="السيرفر متصل ويعمل بكفاءة عالية (Online)" FontSize="13" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ModalServerLatencyText" Text="⚡ زمن الاستجابة: 12 ms • المنفذ نشط وجاهز لاستقبال الطلبات" FontSize="11.5" Foreground="#166534"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🔍 فحص الآن" Click="TestCurrentConnection_Click" Height="32" Padding="12,0" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="11.5" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 2. Presets Quick Pickers -->
                    <TextBlock Text="اختر خادم جاهز أو اكتب الرابط بالأسفل:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <Button Content="💻 محلي (5000)" Click="PresetLocal5000_Click" Style="{StaticResource OutlineButtonStyle}" Height="34" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold" ToolTip="http://localhost:5000"/>
                        <Button Content="🔄 بديل (8080)" Click="PresetLocal8080_Click" Style="{StaticResource OutlineButtonStyle}" Height="34" Margin="2,0,2,0" FontSize="11" FontWeight="SemiBold" ToolTip="http://localhost:8080"/>
                        <Button Content="☁️ سحابي أونلاين" Click="PresetCloud_Click" Style="{StaticResource OutlineButtonStyle}" Height="34" Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" ToolTip="السيرفر السحابي المرفوع"/>
                    </UniformGrid>

                    <!-- 3. Custom URL Input -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="رابط السيرفر الأساسي (Server Base URL):" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <Grid>
                            <TextBox x:Name="ModalServerUrlInput" Text="http://localhost:5000" Height="42" Style="{StaticResource ModernTextBox}" FontSize="13" Padding="10,0"/>
                        </Grid>
                        <TextBlock Text="💡 للأجهزة المتصلة عبر شبكة العيادة الداخلية (Wi-Fi): أدخل IP الجهاز الرئيسي مثلاً: http://192.168.1.100:5000" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 4. Diagnostic Feedback Banner -->
                    <Border x:Name="ModalDiagnosticBanner" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                        <TextBlock x:Name="ModalDiagnosticText" Text="جاري فحص الاتصال..." FontSize="12" FontWeight="SemiBold" Foreground="#0284C7" TextWrapping="Wrap"/>
                    </Border>

                    <!-- 5. Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="💾 حفظ واعتماد السيرفر" Click="SaveServerUrl_Click" Height="40" Padding="20,0" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}" FontWeight="Bold" FontSize="13" Margin="0,0,10,0"/>
                            <Button Content="🔄 تشغيل واكتشاف تلقائي" Click="AutoDetectServer_Click" Height="40" Padding="14,0" Style="{StaticResource OutlineButtonStyle}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="إغلاق" Click="CloseServerSettingsModal_Click" Height="40" Padding="18,0" Style="{StaticResource OutlineButtonStyle}" FontSize="12.5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Startup Loading Screen Overlay -->
        <Grid x:Name="StartupLoadingOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#FFFFFF" Visibility="Visible">
            <Border Background="#FFFFFF" CornerRadius="24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.09"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="80" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock Text="+" FontSize="42" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="عيادة د. صديق" FontSize="26" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="المنظومة الطبية والمالية الموحدة" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <!-- Animated Progress Bar -->
                    <ProgressBar IsIndeterminate="True" Height="6" Width="360" Background="#F1F5F9" Foreground="#0284C7" BorderThickness="0" Margin="0,20,0,14">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>

                    <!-- Dynamic Loading Status Text -->
                    <TextBlock x:Name="StartupStatusText" Text="جاري بدء التشغيل وتجهيز المنظومة..." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
