<UserControl x:Class="SeddikClinic.Desktop.Views.ExpenseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F8FAFC">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ExpensesGridCard" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Actions / Search -->
            <RowDefinition Height="Auto"/> <!-- Add Expense Animated Form Card -->
            <RowDefinition Height="*"/>    <!-- Expenses DataGrid Card -->
        </Grid.RowDefinitions>

        <!-- Top Header & Search Filter Card -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="18,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Title and Main Action Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#ECFDF5" CornerRadius="10" Padding="10,8" Margin="0,0,15,0" VerticalAlignment="Center">
                            <TextBlock Text="💰" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إدارة المصروفات اليومية والشهرية" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="تسجيل ومتابعة الفواتير ومصروفات العيادة والمعامل والتصنيفات" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Add Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ إضافة تصنيف جديد 📁" Click="ToggleAddCategoryModal_Click" Height="40" Background="#EDE9FE" Foreground="#7C3AED" FontWeight="Bold" BorderBrush="#DDD6FE" BorderThickness="1" Padding="14,0" Margin="0,0,10,0" Style="{StaticResource OutlineButtonStyle}" Cursor="Hand"/>
                        <Button Content="+ إضافة مصروف جديد ➕" Click="ToggleAddPanel_Click" Height="40" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Comprehensive Filters (Search, Category, Date Range & Quick Presets) -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <TextBox x:Name="SearchBox" Width="170" Height="36" Style="{StaticResource ModernTextBox}" Margin="0,0,10,6" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="بحث باسم المصروف أو المستفيد أو رقم الإيصال"/>

                    <!-- Category Filter -->
                    <ComboBox x:Name="CategoryFilterCombo" Width="150" Height="36" Background="#F8FAFC" SelectionChanged="CategoryFilter_Changed" Margin="0,0,10,6" DisplayMemberPath="NameAr" VerticalAlignment="Center"/>

                    <!-- Date Range Box (من تاريخ و إلى تاريخ) -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 من:" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="StartDatePicker" Height="30" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <TextBlock Text="إلى:" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="EndDatePicker" Height="30" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <Button Content="تطبيق الفترة 🔍" Click="ApplyDateFilter_Click" Height="30" Padding="12,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Preset Filters -->
                    <Button Content="الكل" Click="FilterAll_Click" Height="36" Padding="10,0" Margin="0,0,6,6" Style="{StaticResource OutlineButtonStyle}"/>
                    <Button Content="اليوم" Click="FilterToday_Click" Height="36" Padding="10,0" Margin="0,0,6,6" Style="{StaticResource OutlineButtonStyle}"/>
                    <Button Content="هذا الشهر" Click="FilterMonth_Click" Height="36" Padding="10,0" Margin="0,0,10,6" Style="{StaticResource OutlineButtonStyle}"/>

                    <!-- Refresh Button -->
                    <Button Content="تحديث 🔄" Click="RefreshExpenses_Click" Style="{StaticResource OutlineButtonStyle}" Height="36" Margin="0,0,0,6"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Add Expense Slide-Down Form Card -->
        <Border x:Name="AddExpensePanel" Grid.Row="1" Background="#FFFFFF" CornerRadius="16" Padding="24" Margin="0,0,0,20" BorderBrush="#0284C7" BorderThickness="1.5" Effect="{StaticResource CardShadow}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                    <TextBlock Text="➕ تسجيل فاتورة أو مصروف جديد" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock Text=" (يتم حفظ السجل في Audit Log مع تاريخ واسم الطبيب أو المستخدم)" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="اسم المصروف / البيان:" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ExpenseTitleInput" Height="40" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="التصنيف:" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ExpenseCategoryCombo" Height="40" DisplayMemberPath="NameAr" Grid.Column="0" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="➕ تصنيف" Click="ToggleAddCategoryModal_Click" Height="40" Padding="8,0" Background="#EDE9FE" Foreground="#7C3AED" FontWeight="Bold" BorderThickness="0" Cursor="Hand" ToolTip="إضافة تصنيف جديد سريعاً"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="المبلغ (ج.م):" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ExpenseAmountInput" Height="40" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="طريقة الدفع:" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PaymentMethodCombo" Height="40" SelectedIndex="0">
                            <ComboBoxItem Content="نقداً (Cash)"/>
                            <ComboBoxItem Content="بطاقة مدى / ائتمان"/>
                            <ComboBoxItem Content="تحويل بنكي"/>
                            <ComboBoxItem Content="شيك"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ وتأكيد المصروف ✅" Click="SaveExpense_Click" Height="40" Padding="22,0" Background="#10B981" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="إلغاء ✖" Click="ToggleAddPanel_Click" Height="40" Style="{StaticResource OutlineButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Expenses DataGrid Card -->
        <Border x:Name="ExpensesGridCard" Grid.Row="2" Background="#FFFFFF" CornerRadius="16" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="ExpensesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="46" FontSize="13" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المصروف" Binding="{Binding ExpenseNumber}" Width="135"/>
                    <DataGridTextColumn Header="اسم المصروف" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryNameAr}" Width="145"/>
                    <DataGridTextColumn Header="المبلغ (ج.م)" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="120"/>
                    <DataGridTextColumn Header="تاريخ الدفع" Binding="{Binding PaymentDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="110"/>
                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodNameAr}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusNameAr}" Width="100"/>
                    
                    <!-- أُضيف بواسطة من -->
                    <DataGridTextColumn Header="أُضيف بواسطة" Binding="{Binding CreatedByUserName}" Width="130"/>

                    <!-- إجراءات: إلغاء وحذف -->
                    <DataGridTemplateColumn Header="إجراءات" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="إلغاء 🚫" Click="CancelExpense_Click" ToolTip="إلغاء المصروف وتغيير حالته لملغي" Background="#FEF3C7" Foreground="#D97706" FontWeight="SemiBold" BorderThickness="0" Padding="8,4" Height="30" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="حذف 🗑️" Click="DeleteExpense_Click" ToolTip="حذف المصروف نهائياً من السجلات" Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" BorderThickness="0" Padding="8,4" Height="30" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Modal: إضافة تصنيف مصروفات جديد (Add Expense Category Modal) -->
        <Grid x:Name="AddCategoryModal" Grid.Row="0" Grid.RowSpan="3" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="20" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Form Fields -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="إضافة تصنيف مصروفات جديد" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="تحديد مسمى التصنيف لتصنيف الفواتير والمصروفات بدقة" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="CloseAddCategoryModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,22">
                        <TextBlock Text="اسم التصنيف (بالعربية):" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="NewCategoryNameInput" Height="40" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="NewCategoryDirectCostCheck" Content="هل يعتبر تكلفة طبية مباشرة؟ (مثل مستلزمات المعامل والعيادة)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ التصنيف ✅" Click="SaveCategory_Click" Height="42" Padding="26,0" Background="#10B981" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="إلغاء ✖" Click="CloseAddCategoryModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
