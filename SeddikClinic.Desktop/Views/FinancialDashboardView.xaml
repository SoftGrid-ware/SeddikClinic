<UserControl x:Class="SeddikClinic.Desktop.Views.FinancialDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F8FAFC">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainScroll" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Action Bar -->
            <RowDefinition Height="Auto"/> <!-- Professional Date Range Filter Box -->
            <RowDefinition Height="Auto"/> <!-- Status / Wakeup banner -->
            <RowDefinition Height="*"/>    <!-- Dashboard Scrollable Body -->
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="18,14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E0F2FE" CornerRadius="10" Padding="10,8" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="18"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="الأرباح والمصروفات" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="لوحة المؤشرات والتحليلات المالية المباشرة للعيادة" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDailyShift" Content="🔒 تقفيل شيفت اليوم" Click="OpenDailyShiftModal_Click" Height="40" Background="#D97706" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="🤝 أرباح الشركاء" Click="OpenPartnersProfitModal_Click" Height="40" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="تصدير Excel 📊" Click="ExportExcel_Click" Height="40" Background="#10B981" Foreground="White" FontWeight="SemiBold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="طباعة تقرير 🖨️" Click="PrintReport_Click" Height="40" Style="{StaticResource OutlineButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Professional Date Range Filter Control Box (شريط فلترة الفترة من وإلى باحترافية عالية) -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" Padding="16,12" Margin="0,0,0,18" BorderBrush="#BAE6FD" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Period Presets -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="الفترة السريعة:" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnFilterToday" Content="اليوم" Click="FilterPreset_Click" Tag="today" Height="36" Padding="14,0" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFilterWeek" Content="هذا الأسبوع" Click="FilterPreset_Click" Tag="week" Height="36" Padding="14,0" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFilterMonth" Content="الشهر الحالي" Click="FilterPreset_Click" Tag="month" Height="36" Padding="14,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFilterYear" Content="هذا العام" Click="FilterPreset_Click" Tag="year" Height="36" Padding="14,0" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                </StackPanel>

                <!-- Custom Range From & To (من وإلى) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 من تاريخ:" FontSize="12.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="StartDatePicker" Height="34" Width="135" Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <TextBlock Text="إلى تاريخ:" FontSize="12.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="EndDatePicker" Height="34" Width="135" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <Button Content="تطبيق الفترة 🔍" Click="ApplyCustomRange_Click" Height="34" Padding="16,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Refresh Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث الأرقام 🔄" Click="RefreshBtn_Click" Height="38" Padding="16,0" Style="{StaticResource OutlineButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status & Wakeup Banner -->
        <Border x:Name="StatusBanner" Grid.Row="2" Background="#E0F2FE" CornerRadius="10" Padding="12" Margin="0,0,0,16" BorderBrush="#BAE6FD" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="جاري جلب البيانات من الخادم..." Foreground="#0369A1" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel>

                <!-- HERO CARDS ROW 1 (The 4 Pillars with Fixed RTL Grid Layout) -->
                <UniformGrid Columns="4" Margin="0,0,0,20">

                    <!-- Card 1: Month Revenue -->
                    <Border Background="#FFFFFF" CornerRadius="16" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="Revenue" ToolTip="اضغط لعرض كافة تفاصيل الإيرادات والمقبوضات">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="إجمالي الإيرادات المحصلة" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="💵 نقد فعلي 🔍" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="MonthRevenueText" Text="0.00 ج.م" FontSize="26" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,6"/>
                            <TextBlock Text="مجموع المدفوعات المسددة فقط خلال الفترة" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Month Expenses -->
                    <Border Background="#FFFFFF" CornerRadius="16" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="Expenses" ToolTip="اضغط لعرض كافة تفاصيل وحركات المصروفات">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="إجمالي المصروفات المدفوعة" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="💸 مسددة 🔍" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="MonthExpensesText" Text="0.00 ج.م" FontSize="26" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,6"/>
                            <TextBlock Text="المصروفات المدفوعة فعلياً من رصيد العيادة" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Net Cash Flow -->
                    <Border Background="#FFFFFF" CornerRadius="16" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="NetCash" ToolTip="اضغط لعرض معادلة وتفاصيل صافي الكاش">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="صافي التدفق النقدي" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#F0F9FF" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="📈 صافي الكاش 🔍" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="NetCashText" Text="0.00 ج.م" FontSize="26" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,6"/>
                            <TextBlock Text="المحصل - المسترد - المصروفات المدفوعة" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Operating Profit -->
                    <Border Background="#FFFFFF" CornerRadius="16" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="OperatingProfit" ToolTip="اضغط لعرض تفاصيل الربح التشغيلي">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الربح التشغيلي التقديري" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ تشغيلي 🔍" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="OperatingProfitText" Text="0.00 ج.م" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,6"/>
                            <TextBlock Text="قيمة الخدمات - تكاليف المعمل والمواد الطبية" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- SECONDARY METRICS ROW (Today, Receivables, Down payments, Refunds) -->
                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="TodayRevenue" ToolTip="اضغط لعرض تفاصيل إيرادات اليوم">
                        <StackPanel>
                            <TextBlock Text="إيرادات اليوم ☀️ (اضغط للتفاصيل)" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TodayRevenueText" Text="0.00 ج.م" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="TodayExpenses" ToolTip="اضغط لعرض تفاصيل مصروفات اليوم">
                        <StackPanel>
                            <TextBlock Text="مصروفات اليوم 💸 (اضغط للتفاصيل)" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TodayExpensesText" Text="0.00 ج.م" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" Margin="0,0,14,0" BorderBrush="#FFE4E6" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="Uncollected" ToolTip="اضغط لعرض الحالات غير المسددة">
                        <StackPanel>
                            <TextBlock Text="المبالغ المستحقة غير المحصلة ⏳" FontSize="12" FontWeight="SemiBold" Foreground="#E11D48"/>
                            <TextBlock x:Name="UncollectedReceivablesText" Text="0.00 ج.م" FontSize="20" FontWeight="Bold" Foreground="#E11D48" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="DownPayments" ToolTip="اضغط لعرض تفاصيل العربون والمدفوعات">
                        <StackPanel>
                            <TextBlock Text="العربون والدفعات الجزئية 💰" FontSize="12" Foreground="#0284C7"/>
                            <TextBlock x:Name="DownPaymentsText" Text="0.00 ج.م" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- CLINICAL & OPERATIONS METRICS ROW (Visits, Completed, Scheduled, Cancelled) -->
                <TextBlock Text="🩺 حركة الكشوفات والزيارات الطبية خلال الفترة (اضغط على أي بطاقة لعرض المرضى والمواعيد):" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <!-- Total Visits -->
                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" Margin="0,0,14,0" BorderBrush="#BAE6FD" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="TotalVisits" ToolTip="اضغط لعرض كافة الزيارات والحجوزات">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="إجمالي عدد الزيارات" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="👥 إجمالي 🔍" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="TotalVisitsText" Text="0 زيارة" FontSize="22" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,4"/>
                            <TextBlock Text="كافة الحجوزات المسجلة بالفترة" FontSize="10.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Completed Visits -->
                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" Margin="0,0,14,0" BorderBrush="#BBF7D0" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="CompletedVisits" ToolTip="اضغط لعرض الكشوفات المكتملة">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="انتهاء وتم الكشف" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="✅ مكتمل 🔍" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="CompletedVisitsText" Text="0 كشف" FontSize="22" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,4"/>
                            <TextBlock Text="المرضى الذين أتموا الكشف مع الطبيب" FontSize="10.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Scheduled / Waiting Visits -->
                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" Margin="0,0,14,0" BorderBrush="#FDE68A" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="ScheduledVisits" ToolTip="اضغط لعرض المواعيد المجدولة وقيد الانتظار">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="المجدول وقيد الانتظار" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="⏳ قادم 🔍" FontSize="10.5" FontWeight="Bold" Foreground="#D97706"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ScheduledVisitsText" Text="0 موعد" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,4"/>
                            <TextBlock Text="مواعيد مؤكدة في الانتظار أو قادمة" FontSize="10.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Cancelled Visits -->
                    <Border Background="#FFFFFF" CornerRadius="14" Padding="16,14" BorderBrush="#FECACA" BorderThickness="1" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="HeroCard_Click" Tag="CancelledVisits" ToolTip="اضغط لعرض المواعيد الملغاة وأسبابها">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الكشوفات الملغاة" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="❌ ملغي 🔍" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="CancelledVisitsText" Text="0 موعد" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,4"/>
                            <TextBlock Text="مواعيد تم إلغاؤها من المريض أو العيادة" FontSize="10.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- INTERACTIVE VISUAL CHART: DAILY EARNINGS & EXPENSES -->
                <Border Background="#FFFFFF" CornerRadius="16" Padding="24" Margin="0,0,0,24" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Title & Legend in 2-Column Grid -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="📈 الرسم البياني للتدفق اليومي (الإيرادات مقابل المصروفات)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="12" Height="12" Background="#10B981" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="الإيرادات" FontSize="12" Foreground="#64748B" Margin="0,0,15,0"/>

                                <Border Width="12" Height="12" Background="#EF4444" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="المصروفات" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="مقارنة يومية مرئية لأيام الشهر توضح الأيام الأعلى دخلاً" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,18"/>

                        <!-- Visual Dynamic Chart Bars Container -->
                        <ItemsControl x:Name="DailyChartItemsControl" Grid.Row="2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding FormattedDate}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Bars Column -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <!-- Revenue Bar (Green) -->
                                            <Border Width="10" Height="{Binding RevenueHeight}" Background="#10B981" CornerRadius="4,4,0,0" Margin="0,0,2,0" MaxHeight="140"/>
                                            <!-- Expense Bar (Red) -->
                                            <Border Width="10" Height="{Binding ExpenseHeight}" Background="#EF4444" CornerRadius="4,4,0,0" MaxHeight="140"/>
                                        </StackPanel>

                                        <!-- Day Label -->
                                        <TextBlock Grid.Row="1" Text="{Binding DayNumber}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- TWO COLUMN BREAKDOWNS: CATEGORY BUDGETS & TOP SERVICES -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category Breakdown Card -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="16" Padding="22" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="🏷️ توزيع المصروفات حسب التصنيف والميزانية" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
                            
                            <ListView x:Name="CategoryBreakdownList" Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CategoryNameAr}" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" Foreground="#0284C7" FontSize="13"/>
                                                </Grid>

                                                <!-- Animated Progress Bar -->
                                                <ProgressBar Grid.Row="1" Value="{Binding PercentageOfTotal}" Maximum="100" Height="6" Background="#E2E8F0" Foreground="#0284C7"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Top Earning Services Leaderboard Card -->
                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" Padding="22" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="⭐ أكثر الخدمات الطبية تحقيقاً للإيرادات" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
                            
                            <ListView x:Name="TopServicesList" Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ServiceName}" FontWeight="Bold" Foreground="#059669" FontSize="14"/>
                                                    <TextBlock Text="{Binding Count, StringFormat='عدد الحالات: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalRevenue, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- AI Insights & Clinical Practice Performance Card -->
                <Border Background="#FFFFFF" CornerRadius="16" Padding="22" Margin="0,18,0,0" BorderBrush="#BAE6FD" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EFF6FF" CornerRadius="10" Padding="8,6" Margin="0,0,10,0">
                                    <TextBlock Text="🤖" FontSize="18"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="توصيات ومؤشرات الذكاء الاصطناعي السريرية والتشغيلية (AI Dental Practice Insights)" FontSize="15" FontWeight="Bold" Foreground="#0284C7"/>
                                    <TextBlock Text="تحليل ذكي تلقائي لمعدلات الحضور، أوقات الذروة، والخدمات الأعلى ربحية" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                <TextBlock Text="✅ نشط ومحدث تلقائياً" FontWeight="Bold" FontSize="11" Foreground="#059669"/>
                            </Border>
                        </Grid>

                        <!-- Summary Banner -->
                        <Border Grid.Row="1" Background="#F0F9FF" CornerRadius="12" Padding="16,12" Margin="0,0,0,14" BorderBrush="#BAE6FD" BorderThickness="1">
                            <TextBlock x:Name="AiSummaryText" Text="جاري توليد التقرير الذكي ومؤشرات الأداء السريرية..." FontSize="13" FontWeight="SemiBold" Foreground="#0369A1" LineHeight="20" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Actionable Bullet Points -->
                        <StackPanel x:Name="AiRecommendationsContainer" Grid.Row="2">
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBlock Text="💡 تفعيل التذكير بالواتساب قبل 24 ساعة يساعد في رفع معدل حضور المرضى وتقليل الـ No-Shows." FontSize="12" Foreground="#334155"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Modal: عرض كافة تفاصيل وحركات بطاقات المال والتشغيل (Financial & Operations Drilldown Modal) -->
        <Grid x:Name="FinancialDetailsModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="22" Width="880" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                        <RowDefinition Height="*"/>    <!-- Data Tables or Explainer -->
                        <RowDefinition Height="Auto"/> <!-- Footer Close -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="DetailsIconBorder" Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailsIconText" Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailsTitleText" Text="تفاصيل الحركة" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="DetailsSubtitleText" Text="سجل الحركات والتفاصيل الكاملة" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Content="✕" Click="CloseFinancialDetailsModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Summary KPI Strip inside Modal -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="16,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="عدد السجلات:" FontSize="12.5" Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DetailsCountText" Text="0 سجل" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,24,0"/>

                                <TextBlock Text="إجمالي القيمة:" FontSize="12.5" Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DetailsTotalAmountText" Text="0.00 ج.م" FontWeight="Bold" FontSize="13.5" Foreground="#059669"/>
                            </StackPanel>

                            <TextBox x:Name="DetailsSearchBox" Grid.Column="1" Width="200" Height="34" Style="{StaticResource ModernTextBox}" Padding="8,4" FontSize="12" TextChanged="DetailsSearchBox_TextChanged" ToolTip="بحث بالاسم أو الهاتف أو البيان"/>
                        </Grid>
                    </Border>

                    <!-- Content (Appointments Grid OR Expenses Grid OR Explainer Card) -->
                    <Grid Grid.Row="2" Margin="0,0,0,18" MinHeight="250" MaxHeight="450">
                        <!-- 1. Appointments Details DataGrid -->
                        <Border x:Name="AppointmentsDetailsContainer" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Visible">
                            <DataGrid x:Name="ModalAppointmentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0" RowHeight="46" FontSize="12.5">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateFormatted}" Width="100"/>
                                    <DataGridTextColumn Header="الوقت" Binding="{Binding StartTimeFormatted}" Width="90"/>
                                    <DataGridTextColumn Header="اسم المريض" Binding="{Binding PatientName}" Width="160"/>
                                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PatientPhone}" Width="115"/>
                                    <DataGridTextColumn Header="الخدمة الطبية" Binding="{Binding ServiceType}" Width="*"/>
                                    <DataGridTextColumn Header="الرسوم" Binding="{Binding TotalFees, StringFormat='{}{0:N0} ج.م'}" Width="95"/>
                                    <DataGridTextColumn Header="حالة الكشف" Binding="{Binding StatusNameAr}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 2. Expenses Details DataGrid -->
                        <Border x:Name="ExpensesDetailsContainer" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
                            <DataGrid x:Name="ModalExpensesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0" RowHeight="46" FontSize="12.5">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate, StringFormat='{}{0:yyyy/MM/dd}'}" Width="100"/>
                                    <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding ReceiptNumber}" Width="100"/>
                                    <DataGridTextColumn Header="بيان المصروف" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryNameAr}" Width="130"/>
                                    <DataGridTextColumn Header="المستفيد" Binding="{Binding BeneficiaryName}" Width="130"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N2} ج.م'}" Width="110"/>
                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodNameAr}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 3. Calculation Explainer Card (صافي الكاش والربح التشغيلي) -->
                        <Border x:Name="ExplainerDetailsContainer" Background="#F8FAFC" CornerRadius="14" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="ExplainerHeader" Text="تفاصيل واحتساب المؤشر المالي:" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="ExplainerText" Text="..." FontSize="13.5" LineHeight="24" TextWrapping="Wrap" Foreground="#334155"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="إغلاق النافذة ✖" Click="CloseFinancialDetailsModal_Click" Height="40" Padding="24,0" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal: نظام إدارة الشركاء وتوزيع الأرباح (Partners Profit Share Modal) -->
        <Grid x:Name="PartnersProfitModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="22" Width="840" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Period Net Profit Summary -->
                        <RowDefinition Height="Auto"/> <!-- Add Partner Row -->
                        <RowDefinition Height="*"/>    <!-- Partners DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="🤝" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="نظام الشركاء وتوزيع صافي الأرباح" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="احتساب حصص وصافي ربح كل شريك بناءً على أرباح العيادة المحققة خلال الفترة المحددة" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="ClosePartnersProfitModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Net Profit Summary Card -->
                    <Border Grid.Row="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="14" Padding="18,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="صافي التدفق النقدي الفعلي للعيادة (الفترة المختارة):" FontSize="13" Foreground="#166534" FontWeight="SemiBold"/>
                                <TextBlock Text="مجموع المقبوضات النقدية الفعلية - المصروفات المسددة - المرتجعات" FontSize="11" Foreground="#15803D" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PartnersNetProfitSummaryText" Grid.Column="1" Text="0.00 ج.م" FontSize="22" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Add/Edit Partner Controls -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="اسم الشريك:" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="PartnerNameInput" Height="36" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="النسبة المئوية (%):" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="PartnerPercentInput" Text="50" Height="36" Style="{StaticResource ModernTextBox}" FontWeight="Bold" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="ملاحظات / صفة الشراكة:" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="PartnerNotesInput" Height="36" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="+ إضافة شريك" Click="AddPartner_Click" Height="36" Padding="16,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- Partners Grid -->
                    <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,16" MinHeight="180" MaxHeight="280">
                        <DataGrid x:Name="PartnersGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" MinRowHeight="44" FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الشريك" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="النسبة %" Binding="{Binding Percentage, StringFormat='{}{0}%'}" Width="100" FontWeight="Bold"/>
                                <DataGridTextColumn Header="صافي الربح المستحق (ج.م)" Binding="{Binding CalculatedShare, StringFormat='{}{0:N2} ج.م'}" Width="2*" Foreground="#15803D" FontWeight="Bold"/>
                                <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="1.5*"/>
                                <DataGridTemplateColumn Header="إجراء" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️" Click="DeletePartner_Click" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="حذف الشريك"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ إعدادات الشركاء 💾" Click="SavePartnersSettings_Click" Height="42" Padding="26,0" Background="#10B981" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="إغلاق ✕" Click="ClosePartnersProfitModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal: تقفيل شيفت وجرد الصندوق اليومي (Daily Shift Closing Modal) -->
        <Grid x:Name="DailyShiftModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="22" Width="860" MaxHeight="750" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Shift Numbers & Calculated Cards -->
                            <RowDefinition Height="Auto"/> <!-- Denominations Accordion -->
                            <RowDefinition Height="Auto"/> <!-- Physical Cash Count Input & Status Badge -->
                            <RowDefinition Height="Auto"/> <!-- Handover Notes -->
                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="تقفيل شيفت اليوم وجرد الصندوق النقدي (Shift Settlement)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock x:Name="ShiftSubtitleText" Text="جرد الخزينة، مطابقة النقدية، وإغلاق الوردية الحالية" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="✕" Click="CloseDailyShiftModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Shift Financial Numbers -->
                        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="14" Padding="16,12" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <UniformGrid Columns="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="رصيد فتح الخزينة (قابل للتعديل)" FontSize="11.5" Foreground="#0284C7" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="ShiftOpeningBalanceInput" Text="500.00" Width="130" Height="36" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextAlignment="Center" Margin="0,4,0,0" TextChanged="ShiftOpeningBalanceInput_TextChanged" ToolTip="يمكنك تعديل رصيد بداية الخزينة وسيعاد احتساب المتوقع تلقائياً"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="إيرادات كاش محصلة" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ShiftCashCollectedText" Text="0.00 ج.م" FontSize="15" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="مصروفات نقدية مسددة" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ShiftCashExpensesText" Text="0.00 ج.م" FontSize="15" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="المتوقع بالدرج (السيستم)" FontSize="11.5" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ShiftExpectedCashText" Text="0.00 ج.م" FontSize="16" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- Denominations Calculator Card -->
                        <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🧮 حاسبة تفقيط فئات النقدية بالدرج (اختياري لتسهيل العد):" FontSize="12.5" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="تصفير الحاسبة 🔄" Click="ResetDenominations_Click" Background="Transparent" Foreground="#0284C7" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5"/>
                                </Grid>
                                
                                <UniformGrid Columns="6">
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="فئة 200 ج" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="Denom200Input" Text="0" Height="30" TextAlignment="Center" FontWeight="Bold" Style="{StaticResource ModernTextBox}" TextChanged="DenominationInput_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="فئة 100 ج" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="Denom100Input" Text="0" Height="30" TextAlignment="Center" FontWeight="Bold" Style="{StaticResource ModernTextBox}" TextChanged="DenominationInput_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="فئة 50 ج" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="Denom50Input" Text="0" Height="30" TextAlignment="Center" FontWeight="Bold" Style="{StaticResource ModernTextBox}" TextChanged="DenominationInput_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="فئة 20 ج" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="Denom20Input" Text="0" Height="30" TextAlignment="Center" FontWeight="Bold" Style="{StaticResource ModernTextBox}" TextChanged="DenominationInput_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="فئة 10 ج" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="Denom10Input" Text="0" Height="30" TextAlignment="Center" FontWeight="Bold" Style="{StaticResource ModernTextBox}" TextChanged="DenominationInput_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="فئة 5 ج فما دون" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="Denom5Input" Text="0" Height="30" TextAlignment="Center" FontWeight="Bold" Style="{StaticResource ModernTextBox}" TextChanged="DenominationInput_TextChanged"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Physical Cash Count & Difference Status -->
                        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="14" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="💵 إجمالي النقدية الفعلية الموجودة بالدرج (الجرد الفعلي):" FontSize="13" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="ActualCashDrawerInput" Height="42" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" TextChanged="ActualCashDrawerInput_TextChanged"/>
                                </StackPanel>

                                <Border x:Name="ShiftDifferenceBadge" Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="ShiftDifferenceBadgeStatus" Text="✅ الصندوق متطابق بالكامل" FontWeight="Bold" FontSize="13.5" Foreground="#15803D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ShiftDifferenceAmountText" Text="فارق 0.00 ج.م" FontSize="12" Foreground="#166534" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Handover Notes -->
                        <UniformGrid Grid.Row="4" Columns="2" Margin="0,0,0,18">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="مستلم الشيفت / الوردية القادمة:" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="HandedOverToInput" Height="38" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="ملاحظات وتفاصيل التقفيل:" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="ShiftClosingNotesInput" Height="38" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تأكيد إغلاق الوردية 🔒" Click="ConfirmCloseDailyShift_Click" Height="42" Padding="28,0" Background="#DC2626" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                            <Button Content="طباعة محضر تقفيل الوردية 🖨️" Click="PrintShiftReceipt_Click" Height="42" Padding="20,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                            <Button Content="إلغاء ✖" Click="CloseDailyShiftModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
