<UserControl x:Class="SeddikClinic.Desktop.Views.InvoicesBillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="Auto"/> <!-- Filters Bar -->
            <RowDefinition Height="*"/>    <!-- Invoices Table -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="18,14" Margin="0,0,0,18" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="10,8" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock Text="🧾" FontSize="18"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة الفواتير وحالات التقسيط والتحصيل" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="متابعة كافة الفواتير والتحصيلات للمرضى، دفعات التقسيط، السداد الكاش، وتسوية الذمم المالية" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث البيانات 🔄" Click="RefreshInvoices_Click" Style="{StaticResource OutlineButtonStyle}" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary KPI Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <!-- Collected Revenue Card -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18,14" Margin="0,0,12,0" BorderBrush="#BBF7D0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي المحصل من الفواتير والتقسيط" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="KpiCollectedText" Text="0.00 ج.م" FontSize="18" FontWeight="Bold" Foreground="#15803D" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="10" Width="40" Height="40">
                        <TextBlock Text="💵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Uncollected Receivables Card -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18,14" Margin="0,0,12,0" BorderBrush="#FECACA" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="المتبقي من الأقساط والذمم" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="KpiUncollectedText" Text="0.00 ج.م" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="10" Width="40" Height="40">
                        <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Down Payments Card -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18,14" Margin="0,0,12,0" BorderBrush="#FED7AA" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="العربون والدفعات الجزئية" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="KpiDownPaymentsText" Text="0.00 ج.م" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="10" Width="40" Height="40">
                        <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Invoices Count Card -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18,14" BorderBrush="#BAE6FD" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي الفواتير والحالات" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="KpiInvoicesCountText" Text="0 فاتورة" FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="10" Width="40" Height="40">
                        <TextBlock Text="📑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Filters Bar Card -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" Padding="16,12" Margin="0,0,0,18" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <WrapPanel VerticalAlignment="Center">
                <!-- Search Input -->
                <TextBox x:Name="SearchBox" Width="200" Height="36" Style="{StaticResource ModernTextBox}" Margin="0,0,10,6" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="بحث باسم المريض أو رقم الهاتف أو رقم الكشف"/>

                <!-- Status Filter -->
                <ComboBox x:Name="PaymentStatusFilterCombo" Width="220" Height="36" Background="#F8FAFC" SelectionChanged="FilterStatus_Changed" Margin="0,0,10,6" VerticalAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="كافة الفواتير والتحصيلات (الكل)"/>
                    <ComboBoxItem Content="حالات التقسيط والذمم الجارية ⏳"/>
                    <ComboBoxItem Content="فواتير مسددة بالكامل ✅"/>
                    <ComboBoxItem Content="فواتير غير مسددة بالكامل ❌"/>
                </ComboBox>

                <!-- Date Range Box (من تاريخ و إلى تاريخ) -->
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,10,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 من:" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="StartDatePicker" Height="30" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Text="إلى:" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="EndDatePicker" Height="30" Width="120" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <Button Content="تطبيق الفترة 🔍" Click="ApplyDateFilter_Click" Height="30" Padding="12,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Quick Presets -->
                <Button Content="الكل" Click="FilterAll_Click" Height="36" Padding="10,0" Margin="0,0,6,6" Style="{StaticResource OutlineButtonStyle}"/>
                <Button Content="اليوم" Click="FilterToday_Click" Height="36" Padding="10,0" Margin="0,0,6,6" Style="{StaticResource OutlineButtonStyle}"/>
                <Button Content="هذا الشهر" Click="FilterMonth_Click" Height="36" Padding="10,0" Margin="0,0,6,6" Style="{StaticResource OutlineButtonStyle}"/>
            </WrapPanel>
        </Border>

        <!-- Main Invoices & Billing DataGrid Card -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="16" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="InvoicesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="48" FontSize="13" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المطالبة" Binding="{Binding AppointmentNumber}" Width="120"/>
                    <DataGridTextColumn Header="اسم المريض" Binding="{Binding PatientName}" Width="1.5*"/>
                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PatientPhone, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateFormatted, Mode=OneWay}" Width="105"/>
                    <DataGridTextColumn Header="الخدمة الطبية" Binding="{Binding ServiceType, Mode=OneWay}" Width="1.8*"/>
                    <DataGridTextColumn Header="إجمالي القيمة" Binding="{Binding TotalFees, Mode=OneWay, StringFormat='{}{0:N2} ج.م'}" Width="120"/>
                    <DataGridTextColumn Header="المدفوع" Binding="{Binding DepositAmount, Mode=OneWay, StringFormat='{}{0:N2} ج.م'}" Width="110"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, Mode=OneWay, StringFormat='{}{0:N2} ج.م'}" Width="110"/>

                    <!-- Payment Status Badge -->
                    <DataGridTemplateColumn Header="حالة السداد" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFullyPaid}" Value="False">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsZeroPaid}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PaymentStatusText}" FontWeight="Bold" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#15803D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFullyPaid}" Value="False">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsZeroPaid}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="إجراءات التحصيل" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="💵 تحصيل" Click="CollectPayment_Click" ToolTip="تحصيل المبلغ أو القسط وتسجيل السداد فوراً" Background="#DCFCE7" Foreground="#15803D" FontWeight="Bold" BorderThickness="0" Padding="12,4" Height="30" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="🖨️ إيصال" Click="PrintReceipt_Click" ToolTip="طباعة إيصال المطالبة" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Padding="8,4" Height="30" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Modal: تحصيل دفعة / قسط مالي (Collect Payment Modal) -->
        <Grid x:Name="CollectPaymentModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="20" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="💵" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="تحصيل وسداد قسط / دفعة مالية" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="ModalPatientNameText" Text="للمريض: ..." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="CloseCollectPaymentModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Financial Summary Card -->
                    <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <UniformGrid Columns="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="إجمالي الفاتورة" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ModalTotalFeesText" Text="0.00 ج.م" FontSize="14" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="المدفوع مسبقاً" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ModalPaidAmountText" Text="0.00 ج.م" FontSize="14" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="المتبقي للتقسيط" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ModalRemainingText" Text="0.00 ج.م" FontSize="14" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Quick Actions Buttons for Payment -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔄 تصفير المحصل (0 ج.م)" Click="ZeroCollection_Click" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" FontWeight="Bold" Height="34" Margin="0,0,6,0" Cursor="Hand" ToolTip="إعادة المبلغ المحصل للصفر وتعديل المتبقي للإجمالي كاملاً">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button Grid.Column="1" Content="💵 سداد كامل المتبقي" Click="FullPayment_Click" Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0" BorderThickness="1" FontWeight="Bold" Height="34" Margin="6,0,0,0" Cursor="Hand" ToolTip="سداد كامل المبلغ المتبقي على المريض">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المبلغ المراد سداده / تعيينه (ج.م):" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <CheckBox x:Name="SetDirectCollectionCheck" Grid.Column="1" Content="تعيين كإجمالي محصل مباشر" FontWeight="SemiBold" FontSize="12" Foreground="#0284C7" VerticalAlignment="Center" ToolTip="عند التحديد، سيتم استبدال إجمالي المبلغ المحصل بالقيمة المدخلة مباشرة (مثال: 0 ج.م)"/>
                    </Grid>
                    <TextBox x:Name="ModalPaymentAmountInput" Height="40" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="15" Foreground="#15803D" Margin="0,0,0,14" TextChanged="ModalPaymentAmountInput_TextChanged"/>

                    <TextBlock Text="طريقة الدفع:" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ModalPaymentMethodCombo" Height="40" SelectedIndex="0" Margin="0,0,0,14">
                        <ComboBoxItem Content="نقداً (Cash)"/>
                        <ComboBoxItem Content="بطاقة مدى / ائتمان"/>
                        <ComboBoxItem Content="تحويل بنكي"/>
                        <ComboBoxItem Content="شيك"/>
                    </ComboBox>

                    <TextBlock Text="ملاحظات / رقم الإيصال (اختياري):" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="ModalNotesInput" Height="40" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تأكيد وحفظ التحصيل ✅" Click="ConfirmCollectPayment_Click" Height="42" Padding="26,0" Background="#10B981" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="إلغاء ✖" Click="CloseCollectPaymentModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
