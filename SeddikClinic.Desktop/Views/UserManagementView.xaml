<UserControl x:Class="SeddikClinic.Desktop.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Add User Panel -->
            <RowDefinition Height="*"/>    <!-- Users Grid -->
        </Grid.RowDefinitions>

        <!-- Top Header & Action Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="18,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EDE9FE" CornerRadius="10" Padding="10,8" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock Text="🔐" FontSize="18"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock Text="إدارة المستخدمين والصلاحيات" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="التحكم في حسابات الأطباء والمساعدين وتحديد صلاحيات كل موظف بدقة" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Content="تحديث القائمة 🔄" Click="RefreshBtn_Click" Style="{StaticResource OutlineButtonStyle}" Height="40"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ إضافة مستخدم جديد" Click="ToggleAddUserPanel_Click" Height="40" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add User Slide-Down Form Card -->
        <Border x:Name="AddUserPanel" Grid.Row="1" Background="#FFFFFF" CornerRadius="16" Padding="24" Margin="0,0,0,20" BorderBrush="#0284C7" BorderThickness="1.5" Effect="{StaticResource CardShadow}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="➕ إنشاء حساب مستخدم جديد" FontSize="16" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,18"/>

                <!-- Row 1: Credentials -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="الاسم الكامل (الموظف/الطبيب):" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="FullNameInput" Height="40" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="اسم المستخدم (Username):" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="UsernameInput" Height="40" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="كلمة المرور (Password):" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="PasswordInput" Height="40" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="الدور الوظيفي:" FontSize="13" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RoleCombo" Height="40" SelectedIndex="1" SelectionChanged="RoleCombo_SelectionChanged">
                            <ComboBoxItem Content="👑 المدير (كامل الصلاحيات)"/>
                            <ComboBoxItem Content="👤 مساعد العيادة (استقبال/تمريض)"/>
                            <ComboBoxItem Content="🩺 طبيب أخصائي"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <!-- Row 2: Granular Permissions Checkboxes -->
                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="تحديد الصلاحيات الدقيقة لهذا الحساب:" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="PermFinancials" Content="📊 رؤية الأرباح والمؤشرات المالية" Margin="0,0,20,10" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <CheckBox x:Name="PermExpenses" Content="💰 تسجيل المصروفات" IsChecked="True" Margin="0,0,20,10" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <CheckBox x:Name="PermCancelExpenses" Content="❌ إلغاء المصروفات" Margin="0,0,20,10" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <CheckBox x:Name="PermAppointments" Content="📅 حجز وإدارة المواعيد" IsChecked="True" Margin="0,0,20,10" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <CheckBox x:Name="PermPatients" Content="👥 إدارة سجلات المرضى" IsChecked="True" Margin="0,0,20,10" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <CheckBox x:Name="PermExport" Content="📑 تصدير Excel والتقارير" Margin="0,0,20,10" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <CheckBox x:Name="PermUsers" Content="🔐 إدارة المستخدمين والصلاحيات" Margin="0,0,20,10" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ وإنشاء المستخدم ✅" Click="SaveUser_Click" Height="40" Padding="24,0" Background="#10B981" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                    <Button Content="إلغاء ✖" Click="ToggleAddUserPanel_Click" Height="40" Style="{StaticResource OutlineButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Users DataGrid Card -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="16" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" RowHeight="52" FontSize="13" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="140"/>
                    <DataGridTextColumn Header="الدور الوظيفي" Binding="{Binding RoleBadge}" Width="150"/>
                    
                    <!-- User Status Badge Column -->
                    <DataGridTemplateColumn Header="الحالة" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🟢 نشط ومفعل"/>
                                                <Setter Property="Foreground" Value="#15803D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="❄️ مجمد وموقف"/>
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Permissions Summary -->
                    <DataGridTemplateColumn Header="الصلاحيات الممنوحة" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel Margin="0,6">
                                    <Border Background="#E0F2FE" CornerRadius="6" Padding="6,2" Margin="0,0,4,4" Visibility="{Binding CanViewFinancials, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="📊 أرباح" FontSize="10" Foreground="#0284C7" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="0,0,4,4" Visibility="{Binding CanManageAppointments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="📅 مواعيد" FontSize="10" Foreground="#15803D" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#EDE9FE" CornerRadius="6" Padding="6,2" Margin="0,0,4,4" Visibility="{Binding CanManagePatients, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="👥 مرضى" FontSize="10" Foreground="#7C3AED" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#FEF3C7" CornerRadius="6" Padding="6,2" Margin="0,0,4,4" Visibility="{Binding CanManageExpenses, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="💰 مصروفات" FontSize="10" Foreground="#D97706" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#FEE2E2" CornerRadius="6" Padding="6,2" Margin="0,0,4,4" Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="🔐 مستخدمين" FontSize="10" Foreground="#DC2626" FontWeight="SemiBold"/>
                                    </Border>
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="إجراءات الحساب" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="⚙ الصلاحيات" Click="EditPermissions_Click" ToolTip="تعديل واختيار صلاحيات الحساب بدقة" Background="#E0F2FE" Foreground="#0284C7" FontWeight="SemiBold" BorderThickness="0" Padding="8,4" Height="30" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Dynamic Freeze / Activate Button -->
                                    <Button Click="ToggleUser_Click" FontWeight="Bold" BorderThickness="0" Padding="10,4" Height="30" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="❄️ تجميد"/>
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Setter Property="Foreground" Value="#D97706"/>
                                                <Setter Property="ToolTip" Value="إيقاف وتجميد الحساب مؤقتاً ومنعه من الدخول"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Content" Value="🟢 تفعيل"/>
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                        <Setter Property="ToolTip" Value="إعادة تنشيط وتفعيل الحساب فوراً"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="🗑" Click="DeleteUser_Click" Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" BorderThickness="0" Padding="8,4" Height="30" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Modal: تعديل صلاحيات المستخدم (Edit User Permissions Modal) -->
        <Grid x:Name="EditPermissionsModal" Grid.Row="0" Grid.RowSpan="3" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="20" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- User Details Badge -->
                        <RowDefinition Height="*"/>    <!-- Permissions Checkboxes -->
                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🔐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="تعديل صلاحيات المستخدم" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="EditPermUserSubtitle" Text="تحديد الصلاحيات الدقيقة لحساب الموظف" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="CloseEditPermissionsModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- User Details Strip -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="14,10" Margin="0,0,0,18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="EditPermFullNameText" Text="الاسم الكامل" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" Margin="0,0,14,0"/>
                            <TextBlock Text="•" Foreground="#94A3B8" Margin="0,0,14,0"/>
                            <TextBlock x:Name="EditPermUsernameText" Text="اسم المستخدم" FontSize="12.5" Foreground="#64748B" Margin="0,0,14,0"/>
                            <TextBlock Text="•" Foreground="#94A3B8" Margin="0,0,14,0"/>
                            <TextBlock x:Name="EditPermRoleBadgeText" Text="الدور الوظيفي" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7"/>
                        </StackPanel>
                    </Border>

                    <!-- Permissions Checkboxes List -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" Padding="16,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="اختر الصلاحيات الممنوحة لهذا الحساب:" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ModalPermFinancials" Content="📊 رؤية الأرباح والمؤشرات المالية والتقارير" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                            <CheckBox x:Name="ModalPermAppointments" Content="📅 حجز وتعديل وإدارة جدول المواعيد" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                            <CheckBox x:Name="ModalPermPatients" Content="👥 إدارة سجلات وبيانات وتاريخ المرضى" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                            <CheckBox x:Name="ModalPermExpenses" Content="💰 تسجيل وصرف المصروفات" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                            <CheckBox x:Name="ModalPermCancelExpenses" Content="❌ إلغاء وحذف المصروفات" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                            <CheckBox x:Name="ModalPermExport" Content="📑 تصدير الجداول وتقارير Excel" Margin="0,0,0,12" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                            <CheckBox x:Name="ModalPermUsers" Content="🔐 إدارة حسابات المستخدمين وتعديل الصلاحيات" Margin="0,0,0,4" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ الصلاحيات 💾" Click="SavePermissions_Click" Height="42" Padding="28,0" Background="#10B981" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="إلغاء ✖" Click="CloseEditPermissionsModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
