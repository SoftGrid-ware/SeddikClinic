<UserControl x:Class="SeddikClinic.Desktop.Views.FacebookMarketingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F8FAFC">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" Color="#0F172A" Opacity="0.06" ShadowDepth="2"/>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Studio (Left Generator & Right Preview) -->
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="18,14" Margin="0,0,0,18" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="12" Padding="10,8" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="📢" FontSize="22"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة صفحة الفيسبوك والتسويق الذكي بالذكاء الاصطناعي" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="توليد منشورات طبية احترافية، إدارة الإعلانات، إضافة الهاشتاجات وأرقام العيادة تلقائياً" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🌐 فتح صفحة العيادة على فيسبوك" Click="OpenFacebookPage_Click" Height="40" Background="#1877F2" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="📊 مدير إعلانات ميتا (Meta Ads)" Click="OpenMetaAdsManager_Click" Height="40" Style="{StaticResource OutlineButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Studio Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- AI Post Generator Panel (Left) -->
                <ColumnDefinition Width="1.15*"/>
                <!-- Live Post & Ads Preview (Right) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Generator Controls Panel -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="16" Padding="20" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="المساعد التسويقي الذكي لطب الأسنان (AI Copywriter)" FontWeight="Bold" FontSize="13.5" Foreground="#15803D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Topic Preset Selection -->
                        <TextBlock Text="اختر موضوع أو تخصص المنشور الطبي:" FontSize="13" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PostTopicCombo" Height="40" Background="#F8FAFC" SelectionChanged="PostTopicCombo_SelectionChanged" Margin="0,0,0,14">
                            <ComboBoxItem Content="🦷 زراعة الأسنان الفورية وبدون ألم" IsSelected="True"/>
                            <ComboBoxItem Content="✨ تبييض الأسنان بالليزر وابتسامة هوليوود"/>
                            <ComboBoxItem Content="😁 تقويم الأسنان الشفاف والمعدني للأطفال والبالغين"/>
                            <ComboBoxItem Content="🩺 علاج جذور وأعصاب الأسنان في جلسة واحدة"/>
                            <ComboBoxItem Content="👶 طب أسنان الأطفال وعلاج التسوس المبكر"/>
                            <ComboBoxItem Content="💎 تركيبات الزيركون والعدسات التجميلية (Veneers)"/>
                            <ComboBoxItem Content="🎉 عرض وخصم خاص على الكشف والتنظيف"/>
                            <ComboBoxItem Content="💡 نصيحة طبية يومية للعناية بصحة الفم واللثة"/>
                        </ComboBox>

                        <!-- Target Audience & Tone -->
                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="نبرة المنشور (Tone):" FontSize="12.5" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PostToneCombo" Height="38" Background="#F8FAFC" SelectedIndex="0">
                                    <ComboBoxItem Content="طبي توعوي ومطمئن 🩺"/>
                                    <ComboBoxItem Content="تسويقي جذاب وعروض 🎁"/>
                                    <ComboBoxItem Content="قصة نجاح مريض (Case Study) 🌟"/>
                                    <ComboBoxItem Content="سريع ومختصر للإنستجرام 📸"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="العرض أو الخصم (اختياري):" FontSize="12.5" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="OfferDiscountInput" Text="خصم 20% لفترة محدودة" Height="38" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Clinic Contact Info Config -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📞 بيانات التواصل المرفقة بالمنشور تلقائياً:" FontSize="12" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="رقم الحجز والاستفسار:" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ClinicPhoneInput" Text="01009563353" Height="34" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="عنوان العيادة:" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ClinicAddressInput" Text="عيادة د. صديق لطب الأسنان" Height="34" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Generate Button -->
                        <Button Content="✨ توليد المنشور بالذكاء الاصطناعي فوراً" Click="GenerateAiPost_Click" Height="44" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="14" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,16"/>

                        <!-- Generated Post Text Editor -->
                        <TextBlock Text="نص المنشور الجاهز للنشر (يمكنك التعديل عليه بحرية):" FontSize="12.5" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="PostContentEditor" Height="220" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBox}" Padding="10" FontSize="13" Margin="0,0,0,14"/>

                        <!-- Actions Strip -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="📋 نسخ النص بالكامل" Click="CopyPostText_Click" Height="38" Padding="18,0" Background="#10B981" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="🚀 نشر مباشر على فيسبوك" Click="PublishToFacebook_Click" Height="38" Padding="18,0" Background="#1877F2" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="🔄 إعادة الصياغة" Click="RegeneratePost_Click" Height="38" Style="{StaticResource OutlineButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Live Post & Social Preview (Right) -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📱 معاينة المنشور كما يظهر للمتابعين على Facebook:" FontSize="13" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- Facebook Feed Card Mockup -->
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="16" Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <!-- Facebook Page Header -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1877F2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="🦷" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="عيادة د. صديق لطب وجراحة الفم والأسنان" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                                            <TextBlock Text=" ✔️" Foreground="#1877F2" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="منذ قليل • 🌍 عام" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="•••" FontSize="16" Foreground="#64748B" VerticalAlignment="Top"/>
                                </Grid>

                                <!-- Post Body Live Text -->
                                <TextBlock x:Name="LivePreviewBodyText" Text="اختر موضوعاً واضغط على 'توليد المنشور بالذكاء الاصطناعي' للمعاينة الفورية هنا..." TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#1E293B" Margin="0,0,0,14"/>

                                <!-- Image Card Placeholder -->
                                <Border Background="#EFF6FF" CornerRadius="10" Height="150" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,0,14">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="صورة البوست الطبية الترويجية للعيادة" FontSize="12" Foreground="#0284C7" FontWeight="Bold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Social Interaction Bar -->
                                <Separator Background="#F1F5F9" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="👍 إعجاب" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="💬 تعليق" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="↗️ مشاركة" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Facebook Ads Insights Card -->
                        <Border Background="#F8FAFC" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 نصائح لحملات الإعلانات الممولة (Meta Ads):" FontSize="12.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,6"/>
                                <TextBlock Text="• استهداف النطاق الجغرافي للعيادة (محيط 5-10 كم) يعطي أعلى معدل تحويل لحجوزات جديدة." FontSize="11.5" Foreground="#334155" LineHeight="18"/>
                                <TextBlock Text="• تضمين زر 'إرسال رسالة واتساب' المباشر يرفع نسبة تواصل المرضى بنسبة 40%." FontSize="11.5" Foreground="#334155" LineHeight="18" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
