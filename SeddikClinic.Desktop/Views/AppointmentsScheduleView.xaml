<UserControl x:Class="SeddikClinic.Desktop.Views.AppointmentsScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F8FAFC"
             PreviewMouseDown="UserControl_PreviewMouseDown">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="AppointmentsGridCard" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Action bar (Row 0) -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards Row (Row 1) -->
            <RowDefinition Height="*"/>    <!-- Appointments DataGrid Card (Row 2) -->
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Bar with Day Navigator Strip -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="18,14" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="#E0F2FE" CornerRadius="10" Padding="10,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="18"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="جدول المواعيد والحجوزات" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="إدارة جدول الكشوفات ومواعيد المرضى" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Day Navigator (التنقل بين الأيام على مدار السنة) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="◀ السابق" Click="PrevDay_Click" ToolTip="اليوم السابق" Height="38" Padding="12,0" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    
                    <Button x:Name="TodayNavBtn" Content="اليوم 📅" Click="TodayBtn_Click" ToolTip="عرض مواعيد اليوم الحالي فقط" Height="38" Padding="14,0" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                    
                    <Button Content="التالي ▶" Click="NextDay_Click" ToolTip="اليوم التالي" Height="38" Padding="12,0" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>

                    <DatePicker x:Name="AppointmentDatePicker" Width="140" Height="38" SelectedDateChanged="DatePicker_SelectedDateChanged" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedDayDisplayText" Text="اليوم" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7"/>
                    </Border>

                    <Button Content="تحديث 🔄" Click="RefreshBtn_Click" Style="{StaticResource OutlineButtonStyle}" Height="38" Padding="12,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="مواعيد العمل ⚙️" Click="OpenWorkingHoursModal_Click" Height="40" Padding="14,0" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="+ حجز موعد جديد" Click="ToggleAddBookingPanel_Click" Height="40" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Status Cards Row (4 Pillars of Today's Clinic Schedule) -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <!-- Total Today -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="مواعيد اليوم الكلية 📅" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="TotalTodayCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Waiting in Lounge -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18" Margin="0,0,12,0" BorderBrush="#FEF3C7" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="في صالة الانتظار ⏳" FontSize="12" FontWeight="SemiBold" Foreground="#D97706"/>
                    <TextBlock x:Name="WaitingCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Inside Doctor Room -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18" Margin="0,0,12,0" BorderBrush="#EDE9FE" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="داخل غرفة الكشف 🩺" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED"/>
                    <TextBlock x:Name="InProgressCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Completed Visits -->
            <Border Background="#FFFFFF" CornerRadius="14" Padding="18" BorderBrush="#DCFCE7" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="تم الانتهاء من الكشف ✅" FontSize="12" FontWeight="SemiBold" Foreground="#059669"/>
                    <TextBlock x:Name="CompletedCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Appointments DataGrid Card -->
        <Border x:Name="AppointmentsGridCard" Grid.Row="2" Background="#FFFFFF" CornerRadius="16" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="AppointmentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" Foreground="#0F172A" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column" MinRowHeight="58" FontSize="13" ColumnWidth="*" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <!-- إزالة ألوان التحديد الزرقاء الصارخة واستبدالها بلون مريح هادئ للعين -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- لون سماوي فاتح مريح وهادئ للعين يبرز الصف بدون إخفاء رقم الهاتف -->
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="BorderBrush" Value="#7DD3FC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="14,12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="AppointmentsGridContextMenu" FlowDirection="RightToLeft" Opened="AppointmentsGridContextMenu_Opened">
                        <MenuItem Header="➕ إضافة وتعديل الخدمات والرسوم للمريض" Click="ContextMenu_AddService_Click" FontWeight="Bold"/>
                        <MenuItem Header="🧾 فواتير وحسابات المريض (المسدد والمتبقي)" Click="ContextMenu_OpenPatientInvoices_Click" FontWeight="Bold"/>
                        <Separator/>
                        <MenuItem Header="🦷 فتح خريطة الأسنان والأشعة (Odontogram)" Click="ContextMenu_OpenDentalChart_Click"/>
                        <MenuItem x:Name="GridContextPrescriptionItem" Header="💊 فتح الروشتة الطبية الذكية (e-Prescription)" Click="ContextMenu_OpenPrescription_Click"/>
                        <MenuItem Header="📋 الملف والتاريخ الطبي والأمراض المزمنة" Click="ContextMenu_OpenMedicalHistory_Click"/>
                        <MenuItem Header="📅 سجل زيارات ومواعيد المريض" Click="ContextMenu_OpenVisitsHistory_Click"/>
                        <Separator/>
                        <MenuItem Header="⏳ نقل إلى صالة الانتظار" Click="SetWaiting_Click"/>
                        <MenuItem Header="🩺 بدء الكشف داخل العيادة" Click="SetInProgress_Click"/>
                        <MenuItem Header="✅ إتمام وإنهاء الكشف" Click="SetCompleted_Click"/>
                        <Separator/>
                        <MenuItem Header="🟢 مراسلة عبر الواتساب" Click="ContextMenu_OpenWhatsApp_Click"/>
                        <MenuItem Header="🖨️ طباعة فاتورة الكشف" Click="PrintInvoice_Click"/>
                        <Separator/>
                        <MenuItem Header="❌ إلغاء الموعد" Click="CancelBooking_Click" Foreground="#DC2626"/>
                        <MenuItem Header="🗑️ حذف الموعد نهائياً" Click="DeleteBooking_Click" Foreground="#991B1B"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- Time & Date Column (الساعة والتاريخ - قابلة للنقر لتعديل وتغيير موعد الحجز) -->
                    <DataGridTemplateColumn Header="الموعد والتاريخ" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="Reschedule_Click" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" ToolTip="انقر لتعديل وتغيير موعد وتاريخ الحجز">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🕒" Margin="0,0,5,0" FontSize="11"/>
                                            <TextBlock Text="{Binding StartTimeFormatted}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                            <TextBlock Text="📅" Margin="0,0,4,0" FontSize="10"/>
                                            <TextBlock Text="{Binding DateFormatted}" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Patient & Contact (Combined for maximum space & elegance) -->
                    <DataGridTemplateColumn Header="المريض والتواصل" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding PatientName}" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="📞" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding PatientPhone}" FontSize="12" Foreground="#334155" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Service Type (With multiline wrapping & click-to-edit) -->
                    <DataGridTemplateColumn Header="الخدمة الطبية" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="ChangeService_Click" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" MinHeight="34" Margin="0,4" Cursor="Hand" ToolTip="انقر لتعديل الخدمات الطبية والرسوم" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✏️" Margin="0,2,6,0" FontSize="11" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ServiceType}" TextWrapping="Wrap" LineHeight="18" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Fees -->
                    <DataGridTemplateColumn Header="الرسوم" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="8,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalFees, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" FontSize="12.5" Foreground="#15803D"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="الحالة" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBackgroundHex}" BorderBrush="{Binding StatusColorHex}" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusNameAr}" Foreground="{Binding StatusColorHex}" FontWeight="Bold" FontSize="11.5"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Booking Source Column -->
                    <DataGridTemplateColumn Header="المصدر" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="6,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceText}" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Notes Button Column -->
                    <DataGridTemplateColumn Header="الملاحظات" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="ViewNotes_Click" ToolTip="انقر لعرض ملاحظات وسبب زيارة المريض" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" Height="30" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" Margin="0,0,4,0" FontSize="11"/>
                                        <TextBlock Text="ملاحظة" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions Column (Single sleek button, all quick actions available via Right-Click or Actions menu) -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="OpenActionsMenu_Click" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Padding="12,5" Height="32" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="انقر لفتح قائمة الإجراءات السريعة (أو اضغط كليك يمين)">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ الإجراءات" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu FontSize="12.5" FlowDirection="RightToLeft" Opened="AppointmentRowContextMenu_Opened">
                                            <MenuItem Header="⏳  نقل إلى صالة الانتظار" Click="SetWaiting_Click" FontWeight="SemiBold"/>
                                            <MenuItem Header="🩺  بدء الكشف داخل العيادة" Click="SetInProgress_Click" FontWeight="SemiBold"/>
                                            <MenuItem Header="✅  إتمام وإنهاء الكشف" Click="SetCompleted_Click" FontWeight="SemiBold"/>
                                            <Separator/>
                                            <MenuItem Header="➕  إضافة وتعديل الخدمات والرسوم" Click="QuickAddService_Click" Foreground="#0284C7" FontWeight="SemiBold"/>
                                            <MenuItem Header="🧾  كشف حساب فواتير المريض" Click="QuickOpenInvoices_Click" Foreground="#D97706" FontWeight="SemiBold"/>
                                            <MenuItem Header="🦷  خريطة الأسنان والأشعة" Click="QuickOpenDentalChart_Click" Foreground="#0284C7" FontWeight="SemiBold"/>
                                            <MenuItem Header="💊  الروشتة الطبية الإلكترونية" Click="PrescriptionFromAppointment_Click" Foreground="#059669" FontWeight="Bold"/>
                                            <MenuItem Header="📋  السجل الطبي وتاريخ الزيارات" Click="QuickViewMedicalRecord_Click" FontWeight="SemiBold"/>
                                            <Separator/>
                                            <MenuItem Header="🟢  إرسال تأكيد الحجز (واتساب)" Click="SendWhatsAppConfirmation_Click" Foreground="#16A34A" FontWeight="Bold"/>
                                            <MenuItem Header="⏰  إرسال تذكير بالموعد (واتساب)" Click="SendWhatsAppReminder_Click" Foreground="#16A34A" FontWeight="SemiBold"/>
                                            <MenuItem Header="🌿  إرسال تعليمات ما بعد الإجراء (واتساب)" Click="SendWhatsAppPostCare_Click" Foreground="#16A34A" FontWeight="SemiBold"/>
                                            <Separator/>
                                            <MenuItem Header="🖨️  طباعة فاتورة الكشف" Click="PrintInvoice_Click" Foreground="#0284C7" FontWeight="Bold"/>
                                            <Separator/>
                                            <MenuItem Header="❌  إلغاء الموعد" Click="CancelBooking_Click" Foreground="#DC2626" FontWeight="SemiBold"/>
                                            <MenuItem Header="🗑️  حذف الموعد نهائياً" Click="DeleteBooking_Click" Foreground="#991B1B" FontWeight="SemiBold"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Modal: إدارة وتعديل الخدمات الطبية للحالة الواحدة (Multi-Service) -->
        <Grid x:Name="EditServiceModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="560" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Add Service Controls -->
                        <RowDefinition Height="*"/>    <!-- Selected Services List -->
                        <RowDefinition Height="Auto"/> <!-- Total & Actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                            <TextBlock Text="🩺" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إدارة الخدمات الطبية للحالة" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="EditServicePatientNameText" Text="للمريض: ..." FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Add Service Section -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="إضافة خدمة طبية جديدة للحالة:" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="PresetServicesCombo" Grid.Column="0" Height="40" Background="#FFFFFF" Foreground="#0F172A" SelectionChanged="PresetServicesCombo_SelectionChanged" Margin="0,0,8,0"/>

                                <TextBox x:Name="NewServiceItemPriceInput" Grid.Column="1" Height="40" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>

                                <Button Grid.Column="2" Content="+ إضافة" Click="AddServiceItem_Click" Height="40" Padding="16,0" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Selected Services List -->
                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16" MinHeight="110" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SelectedServicesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✨" Margin="0,0,6,0" FontSize="12"/>
                                                    <TextBlock Text="{Binding ServiceName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" FontSize="12.5" Foreground="#15803D"/>
                                                </Border>

                                                <Button Grid.Column="2" Content="❌" Click="RemoveServiceItem_Click" ToolTip="حذف الخدمة من هذه الزيارة" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Padding="6,2" Height="28" Width="28" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Total & Actions -->
                    <StackPanel Grid.Row="3">
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="14,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="إجمالي رسوم الكشف والخدمات:" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                    <TextBlock Text="يتم حسابه تلقائياً مع إمكانية التعديل عند الخصم" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="EditServiceFeesInput" Height="40" Width="130" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="14" Foreground="#15803D" TextAlignment="Center"/>
                                    <TextBlock Text="ج.م" FontWeight="Bold" FontSize="13" Foreground="#15803D" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حفظ الخدمات للموعد ✅" Click="SaveServiceChange_Click" Height="42" Padding="24,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="إلغاء ✖" Click="CancelServiceChange_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal: تعديل موعد وتاريخ الحجز (Reschedule Modal) -->
        <Grid x:Name="RescheduleModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                            <TextBlock Text="🕒" FontSize="18"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تعديل وتغيير موعد الحجز" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="ReschedulePatientNameText" Text="للمريض: ..." FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="يوم وتاريخ الحجز الجديد:" FontWeight="SemiBold" FontSize="12.5" Foreground="#475569" Margin="0,0,0,6"/>
                    <DatePicker x:Name="RescheduleDatePicker" Height="40" Margin="0,0,0,14"/>

                    <TextBlock Text="ساعة وتوقيت الحجز الجديد:" FontWeight="SemiBold" FontSize="12.5" Foreground="#475569" Margin="0,0,0,6"/>
                    <ComboBox x:Name="RescheduleTimeCombo" Height="40" Margin="0,0,0,24">
                        <ComboBoxItem Content="12:00 م" Tag="12:00"/>
                        <ComboBoxItem Content="12:30 م" Tag="12:30"/>
                        <ComboBoxItem Content="01:00 م" Tag="13:00"/>
                        <ComboBoxItem Content="01:30 م" Tag="13:30"/>
                        <ComboBoxItem Content="02:00 م" Tag="14:00"/>
                        <ComboBoxItem Content="02:30 م" Tag="14:30"/>
                        <ComboBoxItem Content="03:00 م" Tag="15:00"/>
                        <ComboBoxItem Content="03:30 م" Tag="15:30"/>
                        <ComboBoxItem Content="04:00 م" Tag="16:00"/>
                        <ComboBoxItem Content="04:30 م" Tag="16:30"/>
                        <ComboBoxItem Content="05:00 م" Tag="17:00"/>
                        <ComboBoxItem Content="05:30 م" Tag="17:30"/>
                        <ComboBoxItem Content="06:00 م" Tag="18:00"/>
                        <ComboBoxItem Content="06:30 م" Tag="18:30"/>
                        <ComboBoxItem Content="07:00 م" Tag="19:00"/>
                        <ComboBoxItem Content="07:30 م" Tag="19:30"/>
                        <ComboBoxItem Content="08:00 م" Tag="20:00"/>
                        <ComboBoxItem Content="08:30 م" Tag="20:30"/>
                        <ComboBoxItem Content="09:00 م" Tag="21:00"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ الموعد الجديد 💾" Click="SaveReschedule_Click" Height="42" Padding="24,0" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="إلغاء ✖" Click="CancelReschedule_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal: تنبيه أنيق وشيك لتعارض موعد الحجز (Chic & Elegant Conflict Warning Modal) -->
        <Grid x:Name="ConflictWarningModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Border Background="#FEF3C7" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="#FDE68A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تنبيه: يوجد حجز مسجل في نفس هذا الموعد!" FontSize="15" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ConflictDetailsText" Text="يوجد موعد مسجل مسبقاً بنفس التوقيت..." TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#334155" Margin="0,0,0,14" TextAlignment="Center"/>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBlock Text="💡 يمكنك تأكيد الحجز المزدوج في نفس الميعاد إذا كانت سعة العيادة تسمح، أو اختيار موعد آخر." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" TextAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="تأكيد الحجز في نفس الوقت ✅" Click="ConfirmConflictBooking_Click" Height="42" Padding="20,0" Background="#F59E0B" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="تغيير الموعد ✖" Click="CancelConflict_Click" Height="42" Padding="20,0" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal: حجز موعد جديد منبثق بخلفية داكنة شفافة احترافية (New Booking Modal with Dark Transparent Backdrop) -->
        <Grid x:Name="AddBookingModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="22" Width="680" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header (Row 0) -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Form Content (Row 1) -->
                        <RowDefinition Height="Auto"/> <!-- Conflict Warning Banner (Row 2) -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons (Row 3) -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="حجز موعد كشف جديد" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="تسجيل بيانات المريض والخدمات المطلوبة وتأكيد الموعد فوراً" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Content="✕" Click="ToggleAddBookingPanel_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Form Content Scrollable -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" MaxHeight="520">
                        <StackPanel Margin="2,0,6,0">
                            <!-- Row 1: Patient Info (Phone First, then Name with Auto-detection) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. Phone Number First (رقم الهاتف أولاً مع البحث التلقائي) -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="📞 رقم الهاتف (الموبايل أولاً):" FontSize="13" Foreground="#0F172A" FontWeight="Bold"/>
                                        <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox x:Name="PatientPhoneInput" Height="40" Style="{StaticResource ModernTextBox}"
                                             TextChanged="PatientPhoneInput_TextChanged" LostFocus="PatientPhoneInput_LostFocus"/>
                                </StackPanel>

                                <!-- 2. Patient Name Second (اسم المريض يستدعى تلقائياً) -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="👤 اسم المريض بالكامل:" FontSize="13" Foreground="#0F172A" FontWeight="Bold"/>
                                        <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox x:Name="PatientNameInput" Height="40" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Patient Auto-Fetch Found Notification Badge -->
                            <Border x:Name="ExistingPatientFoundBadge" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✅" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExistingPatientFoundTitle" Text="مريض مسجل مسبقاً في قاعدة البيانات" FontWeight="Bold" FontSize="12.5" Foreground="#15803D"/>
                                        <TextBlock x:Name="ExistingPatientFoundDetails" Text="تم استدعاء بيانات الملف والسجل الطبي تلقائياً لربط الحجز دون تكرار المريض" FontSize="11.5" Foreground="#166534" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 2: Multi-Service Selection Area (إمكانية إضافة أكثر من خدمة للحجز) -->
                            <Border Background="#F8FAFC" CornerRadius="14" Padding="14,12" Margin="0,0,0,16" BorderBrush="#BAE6FD" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🩺 الخدمات الطبية المطلوبة للحجز (يمكن اختيار وإضافة أكثر من خدمة):" FontSize="13" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Service Catalog Dropdown -->
                                        <ComboBox x:Name="ServiceTypeCombo" Grid.Column="0" Height="40" Margin="0,0,10,0" VerticalContentAlignment="Center" SelectionChanged="ServiceTypeCombo_SelectionChanged"/>

                                        <!-- Service Price Input -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBox x:Name="NewBookingServicePriceInput" Height="40" Width="90" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="13" Foreground="#15803D" TextAlignment="Center" Text="250"/>
                                            <TextBlock Text="ج.م" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <!-- Add Service Button -->
                                        <Button Grid.Column="2" Content="+ إضافة الخدمة للحجز" Click="AddBookingServiceItem_Click" Height="40" Padding="18,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </Grid>

                                    <!-- Selected Services Tags / Chips Container -->
                                    <ItemsControl x:Name="BookingSelectedServicesItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✨" FontSize="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding ServiceName}" FontWeight="Bold" FontSize="12.5" Foreground="#1E40AF" Margin="0,0,6,0"/>
                                                        <Border Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" FontSize="11" Foreground="#15803D"/>
                                                        </Border>
                                                        <Button Content="❌" Click="RemoveBookingServiceItem_Click" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" Padding="2,0" FontWeight="Bold" ToolTip="إزالة هذه الخدمة"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Row 3: Timing, Date & Financials (مع إضافة الخصم المالي) -->
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="يوم وتاريخ الحجز:" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="NewBookingDatePicker" Height="40" VerticalAlignment="Center" SelectedDateChanged="NewBookingDatePicker_SelectedDateChanged"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="وقت الحجز:" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="AppointmentTimeCombo" Height="40" SelectedIndex="0" SelectionChanged="AppointmentTimeCombo_SelectionChanged">
                                        <ComboBoxItem Content="10:00 ص" Tag="10:00"/>
                                        <ComboBoxItem Content="10:30 ص" Tag="10:30"/>
                                        <ComboBoxItem Content="11:00 ص" Tag="11:00"/>
                                        <ComboBoxItem Content="11:30 ص" Tag="11:30"/>
                                        <ComboBoxItem Content="12:00 م" Tag="12:00"/>
                                        <ComboBoxItem Content="12:30 م" Tag="12:30"/>
                                        <ComboBoxItem Content="01:00 م" Tag="13:00"/>
                                        <ComboBoxItem Content="01:30 م" Tag="13:30"/>
                                        <ComboBoxItem Content="02:00 م" Tag="14:00"/>
                                        <ComboBoxItem Content="02:30 م" Tag="14:30"/>
                                        <ComboBoxItem Content="03:00 م" Tag="15:00"/>
                                        <ComboBoxItem Content="03:30 م" Tag="15:30"/>
                                        <ComboBoxItem Content="04:00 م" Tag="16:00"/>
                                        <ComboBoxItem Content="04:30 م" Tag="16:30"/>
                                        <ComboBoxItem Content="05:00 م" Tag="17:00"/>
                                        <ComboBoxItem Content="05:30 م" Tag="17:30"/>
                                        <ComboBoxItem Content="06:00 م" Tag="18:00"/>
                                        <ComboBoxItem Content="06:30 م" Tag="18:30"/>
                                        <ComboBoxItem Content="07:00 م" Tag="19:00"/>
                                        <ComboBoxItem Content="07:30 م" Tag="19:30"/>
                                        <ComboBoxItem Content="08:00 م" Tag="20:00"/>
                                        <ComboBoxItem Content="08:30 م" Tag="20:30"/>
                                        <ComboBoxItem Content="09:00 م" Tag="21:00"/>
                                        <ComboBoxItem Content="09:30 م" Tag="21:30"/>
                                        <ComboBoxItem Content="10:00 م" Tag="22:00"/>
                                        <ComboBoxItem Content="10:30 م" Tag="22:30"/>
                                        <ComboBoxItem Content="11:00 م" Tag="23:00"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="إجمالي الرسوم (ج.م):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="FeesInput" Text="250" Height="40" Style="{StaticResource ModernTextBox}" TextChanged="BookingFinancialInput_TextChanged"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="الخصم الممنوح (ج.م):" FontSize="12.5" Foreground="#DC2626" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBox x:Name="DiscountInput" Text="0" Height="40" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="14" Foreground="#DC2626" TextChanged="BookingFinancialInput_TextChanged" ToolTip="قيمة الخصم النقدي للمريض"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Summary Card for Net & Remaining -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الصافي المطلوب بعد الخصم:" FontWeight="Bold" FontSize="12.5" Foreground="#166534" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BookingNetFeesBadgeText" Grid.Column="1" Text="250 ج.م" FontSize="15" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Row 4: Stylish Installment CheckBox & Payment Options -->
                            <Border x:Name="InstallmentModeContainer" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Stylish Checkbox -->
                                        <CheckBox x:Name="EnableInstallmentCheckBox" Grid.Column="0" VerticalAlignment="Center" Checked="EnableInstallmentCheckBox_Changed" Unchecked="EnableInstallmentCheckBox_Changed" Cursor="Hand">
                                            <CheckBox.Content>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="💳" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="سداد عربون / تقسيط مقدماً عند الحجز" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </CheckBox.Content>
                                        </CheckBox>

                                        <!-- Status Badge -->
                                        <Border x:Name="PaymentTypeBadge" Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                            <TextBlock x:Name="PaymentTypeBadgeText" Text="🔴 السداد عند الكشف في العيادة" FontWeight="Bold" FontSize="12" Foreground="#DC2626"/>
                                        </Border>
                                    </Grid>

                                    <!-- Installment Sub-Panel (Appears when checkbox is checked) -->
                                    <Border x:Name="InstallmentDetailsPanel" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Deposit Input -->
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock Text="العربون / المسدد الآن (ج.م):" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <TextBox x:Name="DepositInput" Text="0" Height="38" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="14" Foreground="#15803D" TextChanged="BookingFinancialInput_TextChanged"/>
                                            </StackPanel>

                                            <!-- Remaining Calculation Card -->
                                            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="المبلغ المتبقي للتقسيط والسداد لاحقاً:" FontSize="11.5" Foreground="#991B1B" FontWeight="Bold"/>
                                                        <TextBlock Text="سيتم ترحيله تلقائياً لسجل المريض وشاشة الفواتير والتحصيل" FontSize="10.5" Foreground="#B91C1C" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="BookingRemainingBadgeText" Grid.Column="1" Text="250 ج.م" FontSize="15" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Conflict Warning Banner (رسالة تنبيه بالموعد المكرر أسفل شاشة الحجز) -->
                    <Border x:Name="BookingConflictBanner" Grid.Row="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FDE68A" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="تنبيه: يوجد موعد محجوز مسبقاً في هذا التوقيت!" FontWeight="Bold" FontSize="13" Foreground="#92400E"/>
                                <TextBlock x:Name="BookingConflictBannerText" Text="محجوز للمريض: ..." FontSize="12" Foreground="#B45309" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 4: Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تأكيد الحجز فوراً ✅" Click="ConfirmBooking_Click" Height="42" Padding="28,0" Background="#10B981" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="إلغاء ✖" Click="ToggleAddBookingPanel_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Working Hours Modal -->
        <Grid x:Name="WorkingHoursModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="التحكم في مواعيد عمل العيادة ⚙️" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
                            <TextBlock Text="تحديد ساعات وأيام العمل التي يمكن للمرضى الحجز فيها" FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Click="CloseWorkingHoursModal_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource OutlineButtonStyle}" Width="32" Height="32" Padding="0"/>
                    </Grid>

                    <Border Background="#F8FAFC" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="وقت البدء (مثال 17:00)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="WhStartTimeInput" Text="17:00" Height="36" Padding="8,6" FontSize="13" Background="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="وقت الانتهاء (مثال 22:30)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="WhEndTimeInput" Text="22:30" Height="36" Padding="8,6" FontSize="13" Background="#FFFFFF"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="مدة الكشف (بالدقائق)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="WhDurationInput" Text="30" Height="36" Padding="8,6" FontSize="13" Background="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="أيام العمل" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="WhDaysInput" Text="يومياً عدا الجمعة" Height="36" Padding="8,6" FontSize="13" Background="#FFFFFF"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ ومزامنة المواعيد 💾" Click="SaveWorkingHoursModal_Click" Height="40" Padding="20,0" Background="#16A34A" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="إغلاق" Click="CloseWorkingHoursModal_Click" Height="40" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Patient Notes Modal -->
        <Grid x:Name="PatientNotesModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ملاحظات وسبب زيارة المريض 📄" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
                            <TextBlock x:Name="NotesModalPatientInfo" Text="المريض: ..." FontSize="13" Foreground="#0284C7" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Click="CloseNotesModal_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource OutlineButtonStyle}" Width="32" Height="32" Padding="0"/>
                    </Grid>

                    <Border Background="#F8FAFC" CornerRadius="12" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,18" MinHeight="100">
                        <TextBlock x:Name="NotesModalContentText" Text="لا توجد ملاحظات إضافية" FontSize="14" Foreground="#334155" LineHeight="22" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="إغلاق النافذة" Click="CloseNotesModal_Click" Height="40" Padding="24,0" Background="#0284C7" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cancel Appointment with Reason Modal -->
        <Grid x:Name="CancelAppointmentModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="إلغاء موعد الحجز ❌" FontWeight="Bold" FontSize="18" Foreground="#DC2626"/>
                            <TextBlock x:Name="CancelModalPatientText" Text="المريض: ..." FontSize="13" Foreground="#475569" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Click="CloseCancelModal_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource OutlineButtonStyle}" Width="32" Height="32" Padding="0"/>
                    </Grid>

                    <TextBlock Text="يرجى كتابة سبب الإلغاء لإخطار المريض في تطبيقه:" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="CancellationReasonInput" Text="اعتذار الطبيب لظرف طارئ" Height="40" Style="{StaticResource ModernTextBox}" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تأكيد الإلغاء وإخطار المريض ❌" Click="ConfirmCancelWithReason_Click" Height="42" Padding="20,0" Background="#DC2626" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="تراجع" Click="CloseCancelModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal: السجل المرضي الكامل وتاريخ الزيارات (Patient Medical Profile & Visits History Modal) -->
        <Grid x:Name="MedicalRecordModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="680" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Patient Profile Card -->
                        <RowDefinition Height="Auto"/> <!-- Medical Alerts & Notes -->
                        <RowDefinition Height="*"/>    <!-- Visits History Table -->
                        <RowDefinition Height="Auto"/> <!-- Footer Close Button -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                            <TextBlock Text="📋" FontSize="20"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="السجل الطبي وتاريخ الزيارات" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="ModalPatientSubheaderText" Text="ملف المريض الكامل" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Patient Profile Overview Card -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="كود المريض:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ModalPatientCodeText" Text="P-1001" FontWeight="Bold" FontSize="13" Foreground="#0284C7" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="رقم الهاتف:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ModalPatientPhoneText" Text="010..." FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="السن / الجنس:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ModalPatientAgeGenderText" Text="28 سنة (ذكر)" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="إجمالي الزيارات:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="ModalPatientVisitsCountText" Text="2 زيارة" FontWeight="Bold" FontSize="13" Foreground="#15803D" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Medical Alerts & Chronic Conditions With Edit Button -->
                    <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="#FECACA" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚠️ الحساسية وتنبيهات الأدوية:" FontWeight="Bold" FontSize="12.5" Foreground="#991B1B"/>
                                    <TextBlock x:Name="ModalPatientAllergiesText" Text="لا توجد حساسية مسجلة" FontSize="12.5" Foreground="#B91C1C" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🩺 التاريخ المرضي والأمراض المزمنة:" FontWeight="Bold" FontSize="12.5" Foreground="#475569"/>
                                    <TextBlock x:Name="ModalPatientHistoryText" Text="سليم" FontSize="12.5" Foreground="#334155" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Edit Button inside Modal -->
                            <Button Grid.Column="1" Content="✏️ تعديل التاريخ الطبي" Click="EditMedicalHistoryFromModal_Click" ToolTip="تعديل السجل الطبي والأمراض المزمنة للمريض" Background="#FFFFFF" Foreground="#0284C7" FontWeight="Bold" BorderThickness="1" BorderBrush="#BAE6FD" Padding="12,4" Height="32" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Visits History Table -->
                    <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16" MinHeight="140" MaxHeight="240">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <DataGrid x:Name="VisitsHistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="Transparent" BorderThickness="0" RowHeight="44">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding DateFormatted}" Width="95"/>
                                    <DataGridTextColumn Header="الوقت" Binding="{Binding StartTimeFormatted}" Width="85"/>
                                    <DataGridTextColumn Header="الخدمة الطبية المقدمة" Binding="{Binding ServiceType}" Width="*"/>
                                    <DataGridTextColumn Header="إجمالي الرسوم" Binding="{Binding TotalFees, StringFormat='{}{0:N0} ج.م'}" Width="95"/>
                                    <DataGridTextColumn Header="المدفوع / العربون" Binding="{Binding DepositAmount, StringFormat='{}{0:N0} ج.م'}" Width="105"/>
                                    <DataGridTextColumn Header="المتبقي للتقسيط" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} ج.م'}" Width="105"/>
                                    <DataGridTextColumn Header="حالة الزيارة" Binding="{Binding StatusNameAr}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Close Button -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="إغلاق النافذة ✖" Click="CloseMedicalRecordModal_Click" Height="40" Padding="24,0" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal: تعديل التاريخ المرضي والحساسية والأمراض المزمنة (Edit Medical History Modal) -->
        <Grid x:Name="EditMedicalHistoryModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="20" Width="640" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Patient Info Strip -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Edit Form -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🩺" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="تعديل التاريخ المرضي والحساسية للمريض" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="EditHistoryPatientSubtitle" Text="المريض: - | كود: -" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="CloseEditMedicalHistoryModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Patient Info Strip -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="14,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="EditModalPatientNameText" Text="اسم المريض" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,16,0"/>
                            <TextBlock Text="•" Foreground="#94A3B8" Margin="0,0,16,0"/>
                            <TextBlock x:Name="EditModalPatientCodeText" Text="P-1001" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7" Margin="0,0,16,0"/>
                            <TextBlock Text="•" Foreground="#94A3B8" Margin="0,0,16,0"/>
                            <TextBlock x:Name="EditModalPatientPhoneText" Text="010..." FontSize="12.5" Foreground="#334155"/>
                        </StackPanel>
                    </Border>

                    <!-- Form Content ScrollViewer -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" MaxHeight="450">
                        <StackPanel Margin="2,0,6,0">
                            <!-- Section 1: Chronic Diseases (الأمراض المزمنة) -->
                            <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🩺 الأمراض المزمنة والتاريخ الطبي العام (سكر، ضغط، قلب، سيولة...):" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                    <TextBlock Text="اضغط للإضافة السريعة أو اكتب التفاصيل مباشرة في المربع أدناه:" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,10"/>

                                    <!-- Quick Tags for Chronic Illnesses -->
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="+ ضغط دم مرتفع 🩸" Click="QuickAddHistory_Click" Tag="ضغط دم مرتفع" Margin="0,0,8,6" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ مرض السكري 🍬" Click="QuickAddHistory_Click" Tag="مرض السكري" Margin="0,0,8,6" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ أمراض القلب ❤️" Click="QuickAddHistory_Click" Tag="أمراض القلب" Margin="0,0,8,6" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ سيولة الدم وأسبرين 🩸" Click="QuickAddHistory_Click" Tag="سيولة الدم وأدوية أسبرين" Margin="0,0,8,6" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ حساسية صدر وربو 🫁" Click="QuickAddHistory_Click" Tag="ربو وحساسية صدر" Margin="0,0,8,6" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ أمراض الكبد والكلى 🩺" Click="QuickAddHistory_Click" Tag="أمراض الكبد والكلى" Margin="0,0,8,6" Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="تعيين كـ (سليم - لا توجد أمراض مزمنة) ✅" Click="ClearHistory_Click" Margin="0,0,8,6" Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                    </WrapPanel>

                                    <TextBox x:Name="EditModalMedicalHistoryInput" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBox}" Padding="10,8" FontSize="12.5"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Allergies (الحساسية وتنبيهات الأدوية) -->
                            <Border Background="#FFFBEB" CornerRadius="14" Padding="14" Margin="0,0,0,6" BorderBrush="#FDE68A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⚠️ الحساسية وتنبيهات الأدوية المحظورة للمريض:" FontSize="13.5" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,6"/>
                                    <TextBlock Text="اضغط للإضافة السريعة أو اكتب التنبيهات المحددة الخاصة بالأسنان:" FontSize="11.5" Foreground="#B45309" Margin="0,0,0,10"/>

                                    <!-- Quick Allergy Tags -->
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="+ حساسية بنسلين ⚠️" Click="QuickAddAllergy_Click" Tag="حساسية بنسلين" Margin="0,0,8,6" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ حساسية بنج أسنان ⚠️" Click="QuickAddAllergy_Click" Tag="حساسية بنج موضعي" Margin="0,0,8,6" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ حساسية أسبرين / مسكنات" Click="QuickAddAllergy_Click" Tag="حساسية أسبرين ومسكنات NSAIDs" Margin="0,0,8,6" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="+ حساسية لاتكس (قفازات)" Click="QuickAddAllergy_Click" Tag="حساسية لاتكس" Margin="0,0,8,6" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                        <Button Content="تعيين كـ (لا توجد حساسية مسجلة) ✅" Click="ClearAllergies_Click" Margin="0,0,8,6" Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                        </Button>
                                    </WrapPanel>

                                    <TextBox x:Name="EditModalAllergiesInput" Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBox}" Padding="10,8" FontSize="12.5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ التعديلات الطبية 💾" Click="SaveMedicalHistory_Click" Height="42" Padding="28,0" Background="#10B981" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="إلغاء ✖" Click="CloseEditMedicalHistoryModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal: إضافة وتعديل الخدمات والرسوم للمريض -->
        <Grid x:Name="AddPatientServiceModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🩺" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="إضافة وتعديل الخدمات الطبية والرسوم" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="AddServicePatientNameSubtitle" Text="للمريض: ..." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="CloseAddServiceModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <TextBlock Text="اختر الخدمة من كتالوج الأسنان:" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PatientServiceCatalogCombo" Height="40" Background="#F8FAFC" SelectionChanged="PatientServiceCatalogCombo_SelectionChanged" Margin="0,0,0,12"/>

                    <TextBlock Text="اسم الخدمة / الإجراء الطبي (أو خدمة مخصصة):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CustomServiceNameInput" Height="40" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="سعر الخدمة (ج.م):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ServicePriceInput" Text="350" Height="40" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="14" Foreground="#15803D" TextChanged="AddServicePriceOrDiscount_TextChanged"/>
                        </StackPanel>

                        <StackPanel Margin="4,0,4,0">
                            <TextBlock Text="الخصم المالي (ج.م):" FontSize="12.5" Foreground="#DC2626" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ServiceDiscountInput" Text="0" Height="40" Style="{StaticResource ModernTextBox}" FontWeight="Bold" FontSize="14" Foreground="#DC2626" TextChanged="AddServicePriceOrDiscount_TextChanged" ToolTip="قيمة الخصم الممنوح على هذه الخدمة"/>
                        </StackPanel>

                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="تاريخ الخدمة / الزيارة:" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker x:Name="ServiceDatePicker" Height="40" VerticalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Net Price Added Preview -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="صافي المبلغ المضاف لحساب المريض بعد الخصم:" FontWeight="Bold" FontSize="12" Foreground="#166534" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetServicePricePreviewText" Grid.Column="1" Text="350 ج.م" FontSize="14" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="ملاحظات وتفاصيل إضافية عن السن أو الإجراء:" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="ServiceNotesInput" Height="50" TextWrapping="Wrap" Style="{StaticResource ModernTextBox}" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="إضافة الخدمة وحفظ التكلفة 💾" Click="ConfirmAddService_Click" Height="42" Padding="26,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Content="إلغاء ✖" Click="CloseAddServiceModal_Click" Height="42" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal: كشف حساب فواتير ومطالبات المريض -->
        <Grid x:Name="PatientInvoicesModal" Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="18" Width="720" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="كشف حساب فواتير ومطالبات المريض" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="InvoicesModalPatientSubtitle" Text="المريض: ..." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Click="ClosePatientInvoicesModal_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <UniformGrid Columns="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="إجمالي الفواتير والخدمات" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="InvoicesModalTotalFeesText" Text="0.00 ج.م" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="إجمالي المسدد والمحصل" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="InvoicesModalPaidText" Text="0.00 ج.م" FontSize="16" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="المتبقي والذمة المدينة" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="InvoicesModalRemainingText" Text="0.00 ج.م" FontSize="16" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,16">
                        <DataGrid x:Name="PatientInvoicesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" MinRowHeight="44" FontSize="12.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم المطالبة" Binding="{Binding AppointmentNumber}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding DateFormatted}" Width="110"/>
                                <DataGridTextColumn Header="الخدمة" Binding="{Binding ServiceType}" Width="*"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalFees, StringFormat='{}{0:N0} ج.م'}" Width="90" FontWeight="Bold"/>
                                <DataGridTextColumn Header="المسدد" Binding="{Binding DepositAmount, StringFormat='{}{0:N0} ج.م'}" Width="90" Foreground="#15803D" FontWeight="Bold"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} ج.م'}" Width="90" Foreground="#DC2626" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="إغلاق ✕" Click="ClosePatientInvoicesModal_Click" Height="40" Padding="24,0" Style="{StaticResource OutlineButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
