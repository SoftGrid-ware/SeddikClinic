<Window x:Class="SeddikClinic.Desktop.Views.PrescriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="الروشتة الطبية الإلكترونية الذكية - عيادة د. صديق" 
        Height="720" Width="960"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" Color="#0F172A" Opacity="0.06" ShadowDepth="2"/>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Grid (Drug Picker & Current Prescription Items) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Card -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" Padding="18,12" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="10,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="💊" FontSize="20"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DialogTitleText" Text="الروشتة الطبية الإلكترونية الذكية (e-Prescription)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0"/>
                            <Border Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="PatientInfoBadge" Text="المريض: جاري التحميل..." FontSize="12.5" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <Border x:Name="ReadOnlyBadge" Visibility="Collapsed" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="🔒 معاينة وطباعة فقط (مساعد العيادة)" FontSize="12" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DialogSubtitleText" Text="إصدار الوصفات الدوائية ومزامنتها فوراً مع تطبيق المريض والمشاركة عبر الواتساب" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="🦷 عيادة د. صديق للأسنان" FontSize="13" FontWeight="Bold" Foreground="#0284C7"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Content -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <!-- Add Drug Form / Quick Catalog -->
                <ColumnDefinition x:Name="DrugPickerColumn" Width="380"/>
                <!-- Prescription Items Table & Instructions -->
                <ColumnDefinition x:Name="PrescriptionContentColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Quick Drug Picker & Custom Form -->
            <Border x:Name="AddDrugPanel" Grid.Column="0" Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                            <TextBlock Text="➕ إضافة دواء للروشتة" FontSize="13.5" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>

                        <!-- Quick Common Drugs Combo -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="اختر دواء سريع من كتالوج الأسنان:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CommonDrugsCombo" Height="38" Background="#F8FAFC"
                                      SelectionChanged="CommonDrugsCombo_SelectionChanged" DisplayMemberPath="TradeName"/>
                        </StackPanel>

                        <!-- Drug Trade Name -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="اسم الدواء (Trade Name):" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="DrugNameInput" Height="38" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Dosage & Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="التركيز (Dosage):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox x:Name="DrugDosageInput" Text="1g" Height="38" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="المدة (Duration):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox x:Name="DrugDurationInput" Text="5 أيام" Height="38" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Frequency -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="الجرعة والتكرار (Frequency):" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="DrugFrequencyInput" Text="قرص كل 12 ساعة بعد الأكل" Height="38" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Special Instructions -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="تعليمات خاصة للمريض:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="DrugInstructionsInput" Height="42" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Add Item Button -->
                        <Button Content="➕ إضافة الدواء للروشتة" Click="AddDrugItem_Click"
                                Background="#0284C7" Foreground="White" FontSize="13.5" FontWeight="Bold" Height="40" Style="{StaticResource PrimaryButtonStyle}" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Prescription Items Table & Notes -->
            <Border x:Name="PrescriptionRightPanel" Grid.Column="1" Background="#FFFFFF" CornerRadius="14" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Diagnosis Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="التشخيص الطبي (Diagnosis):" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox x:Name="PrescriptionDiagnosisInput" Text="علاج جذور وعصب / التهاب حاد" Height="38" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Items DataGrid -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="4">
                        <DataGrid x:Name="PrescriptionItemsGrid" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" Background="Transparent" 
                                  BorderThickness="0" RowBackground="#FFFFFF" 
                                  AlternatingRowBackground="#F8FAFC" Foreground="#0F172A"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  MinRowHeight="44" FontSize="12.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الدواء" Binding="{Binding MedicationName}" Width="*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="التركيز" Binding="{Binding Dosage}" Width="85"/>
                                <DataGridTextColumn Header="الجرعة والتكرار" Binding="{Binding Frequency}" Width="180"/>
                                <DataGridTextColumn Header="المدة" Binding="{Binding Duration}" Width="80"/>
                                <DataGridTemplateColumn x:Name="ItemActionColumn" Header="إجراء" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️" Click="RemoveDrugItem_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#EF4444" FontSize="13" ToolTip="حذف هذا الدواء"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- General Instructions -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="تعليمات وإرشادات عامة للمريض:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox x:Name="GeneralInstructionsInput" Text="شرب كميات كافية من الماء، تجنب الأطعمة الصلبة على السن المعالج حتى انتهاء العلاج." Height="52" TextWrapping="Wrap" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Actions -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SavePrescriptionBtn" Content="💾 حفظ وإصدار الروشتة" Click="SavePrescription_Click" Margin="0,0,10,0"
                            Background="#10B981" Foreground="White" FontSize="13.5" FontWeight="Bold" Padding="20,10" Style="{StaticResource PrimaryButtonStyle}" Cursor="Hand"/>
                    <Button Content="🟢 إرسال عبر الواتساب" Click="SendWhatsApp_Click" Margin="0,0,10,0"
                            Background="#16A34A" Foreground="White" FontSize="13.5" FontWeight="Bold" Padding="18,10" Style="{StaticResource PrimaryButtonStyle}" Cursor="Hand"/>
                    <Button Content="🖨️ طباعة الروشتة" Click="PrintPrescription_Click"
                            Background="#0284C7" Foreground="White" FontSize="13.5" FontWeight="Bold" Padding="18,10" Style="{StaticResource PrimaryButtonStyle}" Cursor="Hand"/>
                </StackPanel>

                <Button Grid.Column="1" Content="إغلاق ✕" Click="Close_Click"
                        Background="#F1F5F9" Foreground="#475569" FontSize="13" FontWeight="Bold" Padding="20,10" Style="{StaticResource OutlineButtonStyle}" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
