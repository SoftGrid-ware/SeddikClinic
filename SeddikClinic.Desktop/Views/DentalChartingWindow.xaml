<Window x:Class="SeddikClinic.Desktop.Views.DentalChartingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="خريطة الأسنان التفاعلية وأرشيف الأشعة - عيادة د. صديق" 
        Height="820" Width="1160"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Tooth Card Style in Light Theme -->
        <Style x:Key="ToothButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Direction="270" Color="#0F172A"/>
                            </Border.Effect>
                            <Grid Margin="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Tooth FDI Number -->
                                <TextBlock Text="{Binding ToothNumber}" FontSize="11" FontWeight="Bold" 
                                           HorizontalAlignment="Center" Foreground="#475569" Margin="0,2,0,0"/>

                                <!-- Tooth Icon -->
                                <TextBlock Grid.Row="1" Text="🦷" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Condition Tag Badge with High-Contrast Background -->
                                <Border Grid.Row="2" Background="{Binding ConditionBrush}" CornerRadius="6" Margin="1,2,1,2" Padding="2,1">
                                    <TextBlock Text="{Binding ShortConditionCode}" FontSize="8.5" FontWeight="Bold" 
                                               HorizontalAlignment="Center" Foreground="{Binding ConditionForegroundBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="border" Property="Background" Value="#F0F9FF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2.5"/>
                                <Setter TargetName="border" Property="Background" Value="#E0F2FE"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header (Row 0) -->
            <RowDefinition Height="Auto"/>
            <!-- Legend Bar (Row 1) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Row 2) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Card -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="18,14" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Direction="270" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E0F2FE" CornerRadius="10" Padding="8,6" Margin="0,0,10,0">
                            <TextBlock Text="🦷" FontSize="18"/>
                        </Border>
                        <TextBlock Text="خريطة الأسنان التفاعلية (Odontogram)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock x:Name="PatientNameBadge" Text="المريض: جاري التحميل..." FontSize="12.5" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="الترقيم العالمي المعتمد FDI • انقر على أي سن لتحديد الحالة والأسطح والتكلفة المقدرة وحفظ التعديلات" FontSize="11.5" Foreground="#64748B" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Actions / Chart Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AdultTeethBtn" Content="👨‍💼 أسنان البالغين (32)" Click="AdultTeeth_Click" Margin="0,0,8,0"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="PediatricTeethBtn" Content="👶 أسنان الأطفال (20)" Click="PediatricTeeth_Click" Margin="0,0,8,0"
                            Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" Padding="14,8" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="⚙️ إدارة الحالات" Click="OpenConditionManager_Click" Margin="0,0,8,0"
                            Background="#EEF2FF" Foreground="#4F46E5" FontWeight="Bold" Padding="12,8" BorderThickness="1" BorderBrush="#C7D2FE" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="🔄 إعادة ضبط الخريطة" Click="ResetChart_Click"
                            Background="#FEF2F2" Foreground="#DC2626" FontWeight="Bold" Padding="12,8" BorderThickness="1" BorderBrush="#FECACA" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dynamic Legend & Financial Summary Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" Padding="14,10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.03" Direction="270" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dynamic Legend Pills -->
                <ItemsControl x:Name="LegendItemsControl" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding NameAr}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Financial Estimate -->
                <Border Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💰 إجمالي خطة العلاج المقدرة:" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TotalEstimatedPlanCostText" Text="0 ج.م" FontSize="14" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Main Chart & Selected Tooth Editor Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Dental Arch (Upper & Lower Jaws) & X-Rays -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="16" Padding="18" Margin="0,0,14,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Direction="270" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Upper Jaw Header -->
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="🦷 الفك العلوي (Upper Arch)" FontSize="13" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>

                        <!-- Upper Teeth Row -->
                        <ItemsControl x:Name="UpperTeethItemsControl" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ToothButtonStyle}"
                                            Click="ToothButton_Click"
                                            DataContext="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Midline Separator -->
                        <Border Height="1.5" Background="#E2E8F0" Width="560" Margin="0,4,0,14"/>

                        <!-- Lower Teeth Row -->
                        <ItemsControl x:Name="LowerTeethItemsControl" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ToothButtonStyle}"
                                            Click="ToothButton_Click"
                                            DataContext="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Lower Jaw Header -->
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="🦷 الفك السفلي (Lower Arch)" FontSize="13" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>

                        <!-- Images Gallery / Before & After Tab -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📸 أرشيف الأشعة وصور الحالة (Before &amp; After)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                    <Button Content="➕ إضافة صورة/أشعة" Click="AddImage_Click" HorizontalAlignment="Left"
                                            Background="#0284C7" Foreground="White" FontSize="11.5" FontWeight="Bold" Padding="12,5" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                
                                <ListView x:Name="DentalImagesListView" Background="Transparent" BorderThickness="0" Height="105">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="4" Width="130">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.05" Direction="270" Color="#000000"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Border Height="60" Background="#F1F5F9" CornerRadius="6" Margin="0,0,0,4">
                                                        <TextBlock Text="🖼️ صورة سنية" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ImageTypeNameAr}" FontSize="9.5" Foreground="#0284C7" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Tooth Properties Editor Panel -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Direction="270" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Active Tooth Header Badge -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="SelectedToothTitle" Text="اختر سناً لتعديل حالته" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                                <TextBlock x:Name="SelectedToothSubtitle" Text="انقر على أحد الأسنان في الخريطة لبدء التعديل" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Condition Selector -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="حالة السن (Condition):" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B"/>
                                <Button Content="+ تخصيص" Click="OpenConditionManager_Click" HorizontalAlignment="Left" Foreground="#4F46E5" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                            </Grid>
                            
                            <!-- Elegant & Crisp High-Contrast ComboBox with item template -->
                            <ComboBox x:Name="ToothConditionCombo" Height="40" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1.5" Padding="8,4" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding NameAr}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Affected Surfaces (MODBL) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="الأسطح المتأثرة (Surfaces):" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="SurfaceM" Content="Mesial (M)" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="SurfaceO" Content="Occlusal (O)" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="SurfaceD" Content="Distal (D)" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="SurfaceB" Content="Buccal (B)" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="SurfaceL" Content="Lingual (L)" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,8,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Estimated Cost -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="التكلفة المقدرة للعلاج (ج.م):" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <Grid>
                                <TextBox x:Name="ToothEstimatedCostInput" Text="0" Height="38" Background="#FFFFFF" Foreground="#15803D" FontWeight="Bold" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1.5" VerticalContentAlignment="Center" Padding="10,0"/>
                                <TextBlock Text="ج.م" Foreground="#64748B" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Clinical Notes -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="ملاحظات سريرية للسن:" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                            <TextBox x:Name="ToothNotesInput" Height="64" TextWrapping="Wrap" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1.5" Padding="8"/>
                        </StackPanel>

                        <!-- Completed Checkbox -->
                        <CheckBox x:Name="ToothCompletedCheckBox" Content="✅ تم الانتهاء من علاج هذا السن" Foreground="#0284C7" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,16"/>

                        <!-- Save Tooth Button -->
                        <Button Content="💾 حفظ حالة السن" Click="SaveToothRecord_Click"
                                Background="#10B981" Foreground="White" FontSize="14" FontWeight="Bold" Height="42" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Modal: إدارة وتخصيص حالات الأسنان (Add / Delete Tooth Conditions Modal) -->
        <Grid x:Name="ConditionManagerModal" Grid.Row="0" Grid.RowSpan="3" Background="#7F000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" CornerRadius="20" Width="520" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Direction="270" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Add Condition Form -->
                        <RowDefinition Height="*"/>    <!-- Existing Conditions List -->
                        <RowDefinition Height="Auto"/> <!-- Close Button -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="10" Padding="8" Margin="0,0,10,0">
                            <TextBlock Text="⚙️" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="إدارة وتخصيص حالات الأسنان" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="إضافة حالات علاجية جديدة وتحديد ألوانها أو حذف الحالات" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="✕" Click="CloseConditionManager_Click" Width="30" Height="30" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Add Condition Form -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="➕ إضافة حالة سن جديدة:" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="اسم الحالة (بالعربي):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NewConditionNameInput" Height="36" Padding="8,4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="لون الحالة:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="NewConditionColorCombo" Height="36" Background="#FFFFFF" SelectedIndex="0">
                                        <ComboBoxItem Content="🔴 أحمر" Tag="#EF4444"/>
                                        <ComboBoxItem Content="🔵 أزرق" Tag="#3B82F6"/>
                                        <ComboBoxItem Content="🟣 بنفسجي" Tag="#8B5CF6"/>
                                        <ComboBoxItem Content="🟡 ذهبي/أصفر" Tag="#F59E0B"/>
                                        <ComboBoxItem Content="🟢 أخضر زمردي" Tag="#10B981"/>
                                        <ComboBoxItem Content="🔷 تركواز سماوي" Tag="#06B6D4"/>
                                        <ComboBoxItem Content="🌸 وردي" Tag="#EC4899"/>
                                        <ComboBoxItem Content="💎 فيروزي" Tag="#14B8A6"/>
                                        <ComboBoxItem Content="🔘 رمادي داكن" Tag="#64748B"/>
                                        <ComboBoxItem Content="🟧 برتقالي" Tag="#F97316"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Button Content="+ إضافة الحالة فوراً للعيادة" Click="AddNewCondition_Click" Height="36" Background="#4F46E5" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Existing Conditions List -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16" MinHeight="140" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ConditionManagerItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" Background="{Binding ColorBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding NameAr}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                                <!-- Delete button -->
                                                <Button Grid.Column="2" Content="🗑️ حذف" Click="DeleteConditionItem_Click" Background="#FEF2F2" Foreground="#DC2626" FontSize="11" FontWeight="Bold" BorderThickness="0" Padding="8,3" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Close Button -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="إغلاق والعودة للخريطة" Click="CloseConditionManager_Click" Height="38" Padding="20,0" Background="#0284C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
