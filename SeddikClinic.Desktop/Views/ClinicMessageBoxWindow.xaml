<Window x:Class="SeddikClinic.Desktop.Views.ClinicMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FlowDirection="RightToLeft">

    <Border Background="#FFFFFF" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1" Padding="26" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header (Icon + Title + Close) -->
                <RowDefinition Height="Auto"/> <!-- Message Content -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="IconBadge" Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IconText" Text="ℹ️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="تنبيه" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="عيادة د. صديق" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="✕" Click="Close_Click" Width="32" Height="32" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Message Body -->
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <TextBlock x:Name="MessageContentText" Text="محتوى الرسالة..." FontSize="13.5" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="22"/>
            </Border>

            <!-- Action Buttons Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- OK Button -->
                <Button x:Name="BtnOk" Content="حسناً 👍" Click="Ok_Click" Height="42" Padding="28,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>

                <!-- Yes Button -->
                <Button x:Name="BtnYes" Content="نعم، تأكيد ✅" Click="Yes_Click" Height="42" Padding="22,0" Background="#0284C7" Foreground="White" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>

                <!-- No Button -->
                <Button x:Name="BtnNo" Content="لا ❌" Click="No_Click" Height="42" Padding="20,0" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>

                <!-- Cancel Button -->
                <Button x:Name="BtnCancel" Content="إلغاء ✖" Click="Cancel_Click" Height="42" Padding="20,0" Style="{StaticResource OutlineButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
