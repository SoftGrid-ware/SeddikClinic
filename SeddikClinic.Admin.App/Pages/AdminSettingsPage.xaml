<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SeddikClinic.Admin.App.ViewModels"
             x:Class="SeddikClinic.Admin.App.Pages.AdminSettingsPage"
             x:DataType="vm:AdminSettingsViewModel"
             BackgroundColor="#F8FAFC"
             FlowDirection="RightToLeft">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="الإعدادات ومواعيد العمل" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />

            <!-- User Info Card -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="#E2E8F0" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="المستخدم الحالي" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="{Binding UserName, StringFormat='الاسم: {0}'}" FontSize="14" TextColor="#334155" />
                    <Label Text="{Binding UserRole, StringFormat='الدور والصلاحية: {0}'}" FontSize="14" TextColor="#6D28D9" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Working Hours Management Card -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="#E2E8F0" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="التحكم في مواعيد وفترات عمل العيادة" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="تحديد أوقات الحجز المتاحة للمرضى في التطبيق:" FontSize="13" TextColor="#64748B" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="وقت البدء (مثال 17:00)" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,2">
                                <Entry Text="{Binding StartTime}" FontSize="13" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="وقت الانتهاء (مثال 22:30)" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,2">
                                <Entry Text="{Binding EndTime}" FontSize="13" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="مدة الكشف (بالدقائق)" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,2">
                                <Entry Text="{Binding SlotDurationMinutes}" Keyboard="Numeric" FontSize="13" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="أيام العمل" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,2">
                                <Entry Text="{Binding ClinicDays}" FontSize="13" TextColor="#0F172A" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="حفظ وتحديث مواعيد العمل" Command="{Binding SaveWorkingHoursCommand}" BackgroundColor="#16A34A" TextColor="White" FontAttributes="Bold" FontSize="14" CornerRadius="12" HeightRequest="44" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Server Connection Settings -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="#E2E8F0" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="إعدادات خادم العيادة (API URL)" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,4">
                        <Entry Text="{Binding ServerUrl}" FontSize="13" TextColor="#0F172A" />
                    </Border>
                    <Button Text="حفظ وتطبيق الرابط" Command="{Binding SaveServerUrlCommand}" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" FontSize="14" CornerRadius="12" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- Developer & Technical Support Card -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 18" StrokeThickness="1" Stroke="#E2E8F0" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="حقوق الملكية والدعم الفني" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="عيادة د. صديق التخصصية — جميع الحقوق محفوظة" FontSize="13" TextColor="#475569" />
                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,2" />
                    <Label Text="تصميم وبرمجة المنظومة وتطبيقات الهاتف:" FontSize="12" TextColor="#64748B" />
                    <Label Text="د. عبدالرحمن شعبان محمد" FontSize="16" FontAttributes="Bold" TextColor="#6D28D9" />
                    <Label Text="01009563353" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                        <Button Text="اتصال هاتفي" Command="{Binding CallDeveloperCommand}" BackgroundColor="#6D28D9" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="10" HeightRequest="42" />
                        <Button Grid.Column="1" Text="محادثة واتساب" Command="{Binding OpenWhatsAppCommand}" BackgroundColor="#16A34A" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="10" HeightRequest="42" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Logout -->
            <Button Text="تسجيل الخروج" Command="{Binding LogoutCommand}" BackgroundColor="#FEE2E2" TextColor="#DC2626" FontAttributes="Bold" FontSize="15" CornerRadius="14" HeightRequest="50" Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
